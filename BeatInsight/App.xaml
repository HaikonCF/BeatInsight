<Application x:Class="BeatInsight.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:converters="clr-namespace:BeatInsight.Converters">
    <Application.Resources>
        <!-- ========================================================= -->
        <!-- COLOR PALETTE                                             -->
        <!-- ========================================================= -->
        <Color x:Key="CardBackgroundTranslucentColor">#EE161722</Color>

        <Color x:Key="AccentMagentaColor">#FF2E93</Color>
        <Color x:Key="AccentSoftColor">#2A1320</Color>

        <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
        <Color x:Key="TextSecondaryColor">#A0A5B5</Color>
        <Color x:Key="TextMutedColor">#7B8192</Color>

        <Color x:Key="BorderSubtleColor">#272836</Color>
        <Color x:Key="BorderAccentColor">#66FF2E93</Color>

        <!-- Status Colors -->
        <Color x:Key="StatusErrorColor">#EF4444</Color>

        <!-- Solid Brushes -->
        <SolidColorBrush x:Key="CardBackgroundTranslucentBrush" Color="{StaticResource CardBackgroundTranslucentColor}"/>

        <SolidColorBrush x:Key="AccentMagentaBrush" Color="{StaticResource AccentMagentaColor}"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>

        <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}"/>
        <SolidColorBrush x:Key="BorderAccentBrush" Color="{StaticResource BorderAccentColor}"/>

        <SolidColorBrush x:Key="StatusErrorBrush" Color="{StaticResource StatusErrorColor}"/>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0C10"/>
        <SolidColorBrush x:Key="AppSurfaceBrush" Color="#171820"/>
        <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#20222C"/>
        <SolidColorBrush x:Key="AppCardBrush" Color="#EE161722"/>
        <SolidColorBrush x:Key="AppBorderBrush" Color="#272836"/>
        <SolidColorBrush x:Key="AppBorderAccentBrush" Color="#66FF2E93"/>
        <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#A0A5B5"/>
        <SolidColorBrush x:Key="AppTextMutedBrush" Color="#7B8192"/>
        <SolidColorBrush x:Key="AppAccentBrush" Color="#FF2E93"/>
        <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#2A1320"/>
        <SolidColorBrush x:Key="AppDangerBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="AppSuccessBrush" Color="#10B981"/>
        <sys:String x:Key="AppThemeIdentityLabel">BEATINSIGHT</sys:String>
        <Visibility x:Key="AppThemeCharacterVisibility">Collapsed</Visibility>
        <Visibility x:Key="AppThemeNeutralIdentityVisibility">Visible</Visibility>

        <!-- ========================================================= -->
        <!-- CONVERTERS                                                -->
        <!-- ========================================================= -->
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibilityConverter"/>
        <converters:NullOrEmptyToVisibilityConverter x:Key="InvertedNullOrEmptyToVisibilityConverter" Invert="True"/>
        <converters:StructureToBrushConverter x:Key="StructureToBrushConverter"/>
        <converters:TabActiveConverter x:Key="TabActiveConverter"/>
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter"/>
        <converters:NarrowWidthConverter x:Key="NarrowWidthConverter" Threshold="1200"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- ========================================================= -->
        <!-- REUSABLE CONTROL STYLES                                   -->
        <!-- ========================================================= -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundTranslucentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="TabButtonNavStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="1"
                                BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource BorderAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionPillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1F202C"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentMagentaBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2B1D28"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentMagentaBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
