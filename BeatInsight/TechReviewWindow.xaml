<Window x:Class="BeatInsight.TechReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tech Review UI"
        Width="980"
        Height="760"
        MinWidth="900"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#10131A"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="10"
                CornerRadius="8"
                Background="#1AFFFFFF"
                BorderBrush="#33FFFFFF"
                BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="ProgressReviewedText"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="White"
                           Text="Reviewed: 0 / 0"/>
                <WrapPanel Margin="0,6,0,0">
                    <TextBlock x:Name="ProgressTechText" Foreground="#FFD2FFCF" Margin="0,0,18,0" Text="Tech: 0"/>
                    <TextBlock x:Name="ProgressNotTechText" Foreground="#FFFFD1D1" Margin="0,0,18,0" Text="NotTech: 0"/>
                    <TextBlock x:Name="ProgressUnsureText" Foreground="#FFFFF3C8" Margin="0,0,18,0" Text="Unsure: 0"/>
                    <TextBlock x:Name="ProgressRemainingText" Foreground="#FFCCE6FF" Text="Remaining: 0"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0,12,0,12"
                Padding="10"
                CornerRadius="8"
                Background="#1AFFFFFF"
                BorderBrush="#33FFFFFF"
                BorderThickness="1">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Foreground="#CCFFFFFF" FontSize="11" Text="Map"/>
                        <ComboBox x:Name="MapFilterComboBox"
                                  Width="360"
                                  SelectionChanged="MapFilterComboBox_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Foreground="#CCFFFFFF" FontSize="11" Text="Label filter"/>
                        <ComboBox x:Name="LabelFilterComboBox"
                                  Width="170"
                                  SelectionChanged="LabelFilterComboBox_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Foreground="#CCFFFFFF" FontSize="11" Text="Priority"/>
                        <ComboBox x:Name="PriorityFilterComboBox"
                                  Width="120"
                                  SelectionChanged="PriorityFilterComboBox_SelectionChanged"/>
                    </StackPanel>
                </WrapPanel>
                <CheckBox x:Name="ShowDebugScoreCheckBox"
                          Margin="0,10,0,0"
                          Foreground="#CCFFFFFF"
                          Content="Show debug score"
                          IsChecked="False"
                          Checked="ShowDebugScoreCheckBox_Changed"
                          Unchecked="ShowDebugScoreCheckBox_Changed"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Padding="14"
                CornerRadius="8"
                Background="#1AFFFFFF"
                BorderBrush="#33FFFFFF"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="MapHeaderText"
                           Foreground="White"
                           FontWeight="Bold"
                           FontSize="22"
                           Text="No review candidates found"/>

                <TextBlock x:Name="CandidateIndexText"
                           Grid.Row="1"
                           Foreground="#CCFFFFFF"
                           FontSize="14"
                           Margin="0,6,0,0"
                           Text="Candidate 0 / 0"/>

                <TextBlock x:Name="TimeRangeText"
                           Grid.Row="2"
                           Foreground="White"
                           FontSize="18"
                           Margin="0,10,0,0"
                           Text="--:--.--- → --:--.---"/>

                <WrapPanel Grid.Row="3" Margin="0,10,0,0">
                    <TextBlock x:Name="PriorityText" Foreground="#FFE6F3FF" Margin="0,0,18,0" Text="Priority: -"/>
                    <TextBlock x:Name="WindowCountText" Foreground="#FFE6F3FF" Margin="0,0,18,0" Text="Windows merged: 0"/>
                    <TextBlock x:Name="CurrentLabelText" Foreground="#FFE6F3FF" Text="Current label: Unreviewed"/>
                </WrapPanel>

                <TextBlock x:Name="DebugScoreText"
                           Grid.Row="4"
                           Foreground="#FFB8B8B8"
                           Margin="0,8,0,0"
                           Text="Debug score: hidden"
                           Visibility="Collapsed"/>

                <TextBlock x:Name="ErrorText"
                           Grid.Row="5"
                           Foreground="#FFFFA9A9"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="LabelTechButton"
                        Content="TECH"
                        Width="130"
                        Height="48"
                        Margin="0,0,10,0"
                        FontSize="16"
                        FontWeight="Bold"
                        Click="LabelTechButton_Click"/>
                <Button x:Name="LabelNotTechButton"
                        Content="NOT TECH"
                        Width="130"
                        Height="48"
                        Margin="0,0,10,0"
                        FontSize="16"
                        FontWeight="Bold"
                        Click="LabelNotTechButton_Click"/>
                <Button x:Name="LabelUnsureButton"
                        Content="UNSURE"
                        Width="130"
                        Height="48"
                        Margin="0,0,10,0"
                        FontSize="16"
                        FontWeight="Bold"
                        Click="LabelUnsureButton_Click"/>
                <Button x:Name="CopyTimestampButton"
                        Content="Copy Timestamp"
                        Width="140"
                        Height="36"
                        Click="CopyTimestampButton_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button x:Name="PreviousButton"
                        Content="Previous"
                        Width="110"
                        Height="36"
                        Margin="0,0,8,0"
                        Click="PreviousButton_Click"/>
                <Button x:Name="NextButton"
                        Content="Next"
                        Width="110"
                        Height="36"
                        Margin="0,0,8,0"
                        Click="NextButton_Click"/>
                <Button x:Name="SkipButton"
                        Content="Skip"
                        Width="110"
                        Height="36"
                        Click="SkipButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
