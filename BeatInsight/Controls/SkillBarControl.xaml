<UserControl x:Class="BeatInsight.Controls.SkillBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="300" d:DesignHeight="40">
    <Grid ToolTip="{Binding Description}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="9"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding Name, FallbackValue='SKILL'}"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       Foreground="#A0A5B5"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,8,0"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding DisplayValue, FallbackValue='0%'}"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="#FFFFFF"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Track -->
        <Border Grid.Row="1"
                Background="#0F1015"
                BorderBrush="#252633"
                BorderThickness="1"
                CornerRadius="4"
                ClipToBounds="True">
            <Grid x:Name="TrackGrid">
                <!-- Bar Fill -->
                <ProgressBar Value="{Binding Value, FallbackValue=0}"
                             Minimum="0"
                             Maximum="100"
                             Height="7"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{Binding AccentKey, Converter={StaticResource StructureToBrushConverter}}">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Grid>
                                            <Border x:Name="PART_Track" Background="Transparent"/>
                                            <Border x:Name="PART_Indicator"
                                                    HorizontalAlignment="Left"
                                                    CornerRadius="3"
                                                    Background="{TemplateBinding Foreground}"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </Grid>
        </Border>
    </Grid>
</UserControl>
