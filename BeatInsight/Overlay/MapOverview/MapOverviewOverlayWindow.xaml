<Window x:Class="BeatInsight.Overlay.MapOverview.MapOverviewOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:converters="clr-namespace:BeatInsight.Converters"
        Title="BeatInsight Map Overview"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False">
    <Window.Resources>
        <converters:NullOrEmptyToVisibilityConverter x:Key="TextVisibility"/>
    </Window.Resources>

    <Grid>
    <Border Background="{Binding Background}"
            CornerRadius="16"
            Padding="4">
        <Border Background="{Binding CardBackground}"
                BorderBrush="{Binding Border}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Height="3"
                    Margin="0,0,0,12"
                    Background="{Binding Accent}"
                    CornerRadius="2"/>

            <StackPanel Grid.Row="1">
                <TextBlock Text="{Binding Title}"
                           Foreground="{Binding Foreground}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding Title, Converter={StaticResource TextVisibility}}"/>
                <TextBlock Text="{Binding Difficulty}"
                           Margin="0,3,0,0"
                           Foreground="{Binding Accent}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding Difficulty, Converter={StaticResource TextVisibility}}"/>
                <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                    <TextBlock Text="{Binding Artist}"
                               Foreground="{Binding SecondaryForeground}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Artist, Converter={StaticResource TextVisibility}}"/>
                    <TextBlock Text="  •  mapped by "
                               Foreground="{Binding SecondaryForeground}"
                               FontSize="12"
                               Visibility="{Binding Mapper, Converter={StaticResource TextVisibility}}"/>
                    <TextBlock Text="{Binding Mapper}"
                               Foreground="{Binding Foreground}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Mapper, Converter={StaticResource TextVisibility}}"/>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,22,0"
                            Visibility="{Binding StarRating, Converter={StaticResource TextVisibility}}">
                    <TextBlock Text="STAR RATING" Foreground="{Binding SecondaryForeground}" FontSize="9"/>
                    <TextBlock Text="{Binding StarRating}" Foreground="{Binding Foreground}" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,22,0"
                            Visibility="{Binding BeatInsightRating, Converter={StaticResource TextVisibility}}">
                    <TextBlock Text="BEATINSIGHT" Foreground="{Binding SecondaryForeground}" FontSize="9"/>
                    <TextBlock Text="{Binding BeatInsightRating}" Foreground="{Binding Accent}" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="2"
                            Visibility="{Binding Identity, Converter={StaticResource TextVisibility}}">
                    <TextBlock Text="IDENTITY" Foreground="{Binding SecondaryForeground}" FontSize="9"/>
                    <TextBlock Text="{Binding Identity}" Foreground="{Binding Foreground}" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="3"
                       Margin="0,13,0,0"
                       Text="{Binding GameplayDetails}"
                       Foreground="{Binding SecondaryForeground}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Visibility="{Binding GameplayDetails, Converter={StaticResource TextVisibility}}"/>
            </Grid>
        </Border>
    </Border>
    <Grid x:Name="EditChrome" Visibility="Collapsed" Background="Transparent">
        <Border BorderBrush="{Binding EditBorder}" BorderThickness="2" CornerRadius="16"/>
        <Border Height="26" VerticalAlignment="Top" Background="{Binding CardBackground}"
                BorderBrush="{Binding EditBorder}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
            <DockPanel Margin="8,0">
                <TextBlock Text="MAP OVERVIEW" Foreground="{Binding Foreground}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="Drag" Foreground="{Binding SecondaryForeground}" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <primitives:Thumb Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Cursor="SizeNWSE" DragDelta="ResizeThumb_DragDelta">
            <primitives:Thumb.Template>
                <ControlTemplate TargetType="primitives:Thumb">
                    <Border Background="{Binding EditHandle}" CornerRadius="3" Margin="2"/>
                </ControlTemplate>
            </primitives:Thumb.Template>
        </primitives:Thumb>
    </Grid>
    </Grid>
</Window>
