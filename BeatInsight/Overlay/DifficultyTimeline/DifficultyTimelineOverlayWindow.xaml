<Window x:Class="BeatInsight.Overlay.DifficultyTimeline.DifficultyTimelineOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BeatInsight.Overlay.DifficultyTimeline"
        Title="BeatInsight Difficulty Timeline"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False">
    <Border Background="{Binding Background}"
            CornerRadius="14"
            Padding="3">
        <Border Background="{Binding CardBackground}"
                BorderBrush="{Binding Border}"
                BorderThickness="1"
                CornerRadius="11"
                Padding="9,7">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="DIFFICULTY TIMELINE"
                           Foreground="{Binding SecondaryForeground}"
                           FontSize="9"
                           FontWeight="SemiBold"/>

                <local:DifficultyTimelineBarControl Grid.Row="1"
                                                    Margin="0,5,0,0"
                                                    Model="{Binding Model, Mode=OneWay}"
                                                    MarkerRatio="{Binding MarkerRatio, Mode=OneWay}"
                                                    CurrentSectionIndex="{Binding CurrentSectionIndex, Mode=OneWay}"
                                                    MarkerBrush="{Binding Accent, Mode=OneWay}"
                                                    HighlightBrush="{Binding Border, Mode=OneWay}"/>
            </Grid>
        </Border>
    </Border>
</Window>
