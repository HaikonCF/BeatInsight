<Window x:Class="BeatInsight.Overlay.Skills.SkillsOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="BeatInsight Skills"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False">
    <Grid>
    <Border Background="{Binding Background}"
            CornerRadius="16"
            Padding="4">
        <Border Background="{Binding CardBackground}"
                BorderBrush="{Binding Border}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Height="3"
                        Margin="0,0,0,10"
                        Background="{Binding Accent}"
                        CornerRadius="2"/>

                <TextBlock Grid.Row="1"
                           Text="SKILLS"
                           Foreground="{Binding Foreground}"
                           FontSize="13"
                           FontWeight="Bold"/>

                <ItemsControl Grid.Row="2"
                              Margin="0,8,0,0"
                              ItemsSource="{Binding Metrics}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Name}"
                                           Foreground="{Binding DataContext.SecondaryForeground, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="1"
                                             Height="6"
                                             Margin="8,0"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding BarValue, Mode=OneWay}"
                                             Background="{Binding DataContext.Border, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Foreground="{Binding DataContext.Accent, RelativeSource={RelativeSource AncestorType=Window}}"
                                             BorderThickness="0"
                                             VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding DisplayValue}"
                                           Foreground="{Binding DataContext.Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Border>
    <Grid x:Name="EditChrome" Visibility="Collapsed" Background="Transparent">
        <Border BorderBrush="{Binding EditBorder}" BorderThickness="2" CornerRadius="16"/>
        <Border Height="26" VerticalAlignment="Top" Background="{Binding CardBackground}"
                BorderBrush="{Binding EditBorder}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
            <DockPanel Margin="8,0">
                <TextBlock Text="SKILLS" Foreground="{Binding Foreground}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="Drag" Foreground="{Binding SecondaryForeground}" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <primitives:Thumb Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Cursor="SizeNWSE" DragDelta="ResizeThumb_DragDelta">
            <primitives:Thumb.Template>
                <ControlTemplate TargetType="primitives:Thumb">
                    <Border Background="{Binding EditHandle}" CornerRadius="3" Margin="2"/>
                </ControlTemplate>
            </primitives:Thumb.Template>
        </primitives:Thumb>
    </Grid>
    </Grid>
</Window>
