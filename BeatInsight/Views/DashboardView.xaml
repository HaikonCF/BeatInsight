<UserControl x:Class="BeatInsight.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BeatInsight.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1400"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="DashboardCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="Background" Value="#F0121319"/>
            <Setter Property="BorderBrush" Value="#302C2E3A"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="MetadataLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="MetadataValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="SectionSummaryStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Overview.HasSections}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                    <Setter Property="FontStyle" Value="Italic"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Overview.HasSpikes}" Value="True">
                    <Setter Property="Foreground" Value="#F29AC5"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DashboardNavigationButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Foreground" Value="#C8CAD3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="#35111D"/>
                    <Setter Property="BorderBrush" Value="#FF2E93"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#282A34"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="Tag" Value="Close"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#C42B1C"/>
                    <Setter Property="Foreground" Value="White"/>
                </MultiTrigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.78"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="PatternAnalysisItemTemplate">
            <Border Background="#181A22"
                    BorderBrush="#302C2E3A"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{Binding Name}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CoverageDisplay}"
                               Foreground="{StaticResource AccentMagentaBrush}"
                               FontSize="10.5"
                               Margin="0,5,0,0"
                               Visibility="{Binding HasCoverage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding ConfidenceDisplay}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="10"
                               Margin="0,2,0,0"
                               Visibility="{Binding HasConfidence, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding IntensityDisplay}"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="9.5"
                               Margin="0,2,0,0"
                               Visibility="{Binding HasIntensity, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="124"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="DashboardHeader"
                Grid.Row="0"
                Margin="18,34,18,8"
                Background="#F0121318"
                BorderBrush="#44FF2E93"
                BorderThickness="1"
                CornerRadius="18"
                Padding="16,8"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <Image Source="/Assets/Brand/BeatInsightLogo.png"
                           Width="48"
                           Height="48"
                           Stretch="Uniform"/>
                    <TextBlock Margin="13,0,0,0"
                               FontSize="26"
                               FontWeight="Bold"
                               VerticalAlignment="Center">
                        <Run Text="Beat" Foreground="White"/>
                        <Run Text="Insight" Foreground="#FF2E93"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button Content="Overview"
        Style="{StaticResource DashboardNavigationButtonStyle}"
        Tag="{Binding IsOverviewTabActive}"
        MinWidth="76"
        Click="OverviewTabButton_Click"/>

                    <Button Content="Skills"
        Style="{StaticResource DashboardNavigationButtonStyle}"
        Tag="{Binding IsSkillsTabActive}"
        MinWidth="64"
        Click="SkillsTabButton_Click"/>

                    <Button Content="Sections"
        Style="{StaticResource DashboardNavigationButtonStyle}"
        Tag="{Binding IsSectionsTabActive}"
        MinWidth="72"
        Click="SectionsTabButton_Click"/>

                    <Button Content="Patterns"
        Style="{StaticResource DashboardNavigationButtonStyle}"
        Tag="{Binding IsPatternsTabActive}"
        MinWidth="72"
        Click="PatternsTabButton_Click"/>

                    <Button Content="Identity"
        Style="{StaticResource DashboardNavigationButtonStyle}"
        Tag="{Binding IsIdentityTabActive}"
        MinWidth="70"
        Click="IdentityTabButton_Click"/>

                    <Button Content="Difficulty"
        Style="{StaticResource DashboardNavigationButtonStyle}"
        Tag="{Binding IsDifficultyTabActive}"
        MinWidth="76"
        Click="DifficultyTabButton_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Margin="8,0">
                    <Button x:Name="SettingsButton"
                            Width="34" Height="34" Background="Transparent"
                            BorderThickness="0" Foreground="White" FontSize="18" Cursor="Hand" Content="⚙"
                            Click="SettingsButton_Click"/>
                </StackPanel>

                <Border Grid.Column="3"
                        Width="205"
                        Height="58"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="#24151A20"
                        BorderBrush="#332F3340"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="8"
                        Margin="8,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="40" Height="40"
                                 Stroke="#FF2E93" StrokeThickness="2">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding Overview.Assistant.ImageSource}"
                                            Stretch="UniformToFill"
                                            AlignmentX="Center"
                                            AlignmentY="Center"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Overview.Assistant.Name}" Foreground="White"
                                       FontSize="13" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Overview.Assistant.Title}" Foreground="#8F94A3" FontSize="9.5"/>
                        </StackPanel>
                        <Ellipse Grid.Column="2" Width="8" Height="8" Fill="#44E36C"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <StackPanel x:Name="WindowControlsPanel"
                    Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Panel.ZIndex="1000"
                    Margin="0,2,8,0">
            <Button Content="—"
                    Style="{StaticResource WindowControlButtonStyle}"
                    Click="MinimizeButton_Click"/>
            <Button Content="□"
                    Style="{StaticResource WindowControlButtonStyle}"
                    Click="MaximizeButton_Click"/>
            <Button Content="×"
                    Tag="Close"
                    FontSize="15"
                    Style="{StaticResource WindowControlButtonStyle}"
                    Click="CloseButton_Click"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="18,8,18,18">
            <Border Background="#0E0F14" BorderBrush="#221F2230" BorderThickness="1" CornerRadius="16"/>

            <Grid Margin="10">
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Overview.HasBeatmap}" Value="True"/>
                                        <Condition Binding="{Binding IsOverviewTabActive}" Value="True"/>
                                    </MultiDataTrigger.Conditions>

                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.45*"/>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="0.8*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0"
                            Style="{StaticResource DashboardCardStyle}"
                            Margin="0,0,10,10" Padding="0" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding Overview.BackgroundPath}"
                                   Stretch="UniformToFill" Opacity="0.4"
                                   Visibility="{Binding Overview.HasBackground, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#F70E0F14" Offset="0"/>
                                        <GradientStop Color="#D50E0F14" Offset="0.58"/>
                                        <GradientStop Color="#B3171119" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <Grid Margin="20,17">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="BEATMAP INFORMATION" Style="{StaticResource SectionHeadingStyle}"/>

                                <StackPanel Grid.Row="1" Margin="0,12,0,8">
                                    <TextBlock x:Name="OverviewTitleText" Text="{Binding Overview.Title}" Foreground="White" FontSize="26"
                                               FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Overview.Artist}" Foreground="#D8DAE2" FontSize="15"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Margin="0,10,0,0">
                                        <Border Background="#35111D" BorderBrush="#66FF2E93" BorderThickness="1"
                                                CornerRadius="7" Padding="10,5" HorizontalAlignment="Left">
                                            <TextBlock x:Name="OverviewDifficultyText" Text="{Binding Overview.Version}" Foreground="White" FontSize="11"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                                        </Border>
                                        <ItemsControl Margin="0,7,0,0"
                                                      ItemsSource="{Binding Overview.CommunityTags}"
                                                      Visibility="{Binding Overview.HasCommunityTags, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#24141D"
                                                            BorderBrush="#55FF2E93"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="7,3"
                                                            Margin="0,0,6,5">
                                                        <TextBlock FontSize="9.5" Foreground="#E7E8EE">
                                                            <Run Text="{Binding Name}"/>
                                                            <Run Text="  "/>
                                                            <Run Text="{Binding Votes}" Foreground="{StaticResource TextMutedBrush}"/>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Margin="0,7,0,0"
                                                   Text="{Binding Overview.CommunityTagsStatusText}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="10"
                                                   Visibility="{Binding Overview.HasCommunityTagsStatus, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Margin="0,4,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11">
                                            <Run Text="mapped by "/>
                                            <Run Text="{Binding Overview.Creator}" FontWeight="SemiBold" Foreground="White"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0"
      Margin="0,0,0,10">

                                        <Grid.ColumnDefinitions>
                                            <!-- BPM : plus large pour les plages type 164–166 -->
                                            <ColumnDefinition Width="1.25*"/>

                                            <!-- Length -->
                                            <ColumnDefinition Width="1.05*"/>

                                            <!-- Max Combo -->
                                            <ColumnDefinition Width="1.20*"/>

                                            <!-- AR / OD / CS / HP -->
                                            <ColumnDefinition Width="0.80*"/>
                                            <ColumnDefinition Width="0.80*"/>
                                            <ColumnDefinition Width="0.80*"/>
                                            <ColumnDefinition Width="0.80*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- BPM -->
                                        <StackPanel Grid.Column="0"
                Margin="0,0,14,0">
                                            <TextBlock Text="BPM"
                   Style="{StaticResource MetadataLabelStyle}"/>

                                            <TextBlock Text="{Binding Overview.BpmDisplay}"
                   Style="{StaticResource MetadataValueStyle}"
                   Margin="0,2,0,0"
                   TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- LENGTH -->
                                        <StackPanel Grid.Column="1"
                Margin="0,0,14,0">
                                            <TextBlock Text="LENGTH"
                   Style="{StaticResource MetadataLabelStyle}"/>

                                            <TextBlock Text="{Binding Overview.LengthDisplay}"
                   Style="{StaticResource MetadataValueStyle}"
                   Margin="0,2,0,0"
                   TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- MAX COMBO -->
                                        <StackPanel Grid.Column="2"
                Margin="0,0,14,0">
                                            <TextBlock Text="MAX COMBO"
                   Style="{StaticResource MetadataLabelStyle}"/>

                                            <TextBlock Text="{Binding Overview.MaxComboDisplay}"
                   Style="{StaticResource MetadataValueStyle}"
                   Margin="0,2,0,0"
                   TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- AR -->
                                        <StackPanel Grid.Column="3"
                Margin="0,0,10,0">
                                            <TextBlock Text="AR"
                   Style="{StaticResource MetadataLabelStyle}"/>

                                            <TextBlock Text="{Binding Overview.Ar, StringFormat={}{0:F1}}"
                   Style="{StaticResource MetadataValueStyle}"
                   Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- OD -->
                                        <StackPanel Grid.Column="4"
                Margin="0,0,10,0">
                                            <TextBlock Text="OD"
                   Style="{StaticResource MetadataLabelStyle}"/>

                                            <TextBlock Text="{Binding Overview.Od, StringFormat={}{0:F1}}"
                   Style="{StaticResource MetadataValueStyle}"
                   Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- CS -->
                                        <StackPanel Grid.Column="5"
                Margin="0,0,10,0">
                                            <TextBlock Text="CS"
                   Style="{StaticResource MetadataLabelStyle}"/>

                                            <TextBlock Text="{Binding Overview.Cs, StringFormat={}{0:F1}}"
                   Style="{StaticResource MetadataValueStyle}"
                   Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- HP -->
                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="HP"
                   Style="{StaticResource MetadataLabelStyle}"/>

                                            <TextBlock Text="{Binding Overview.Hp, StringFormat={}{0:F1}}"
                   Style="{StaticResource MetadataValueStyle}"
                   Margin="0,2,0,0"/>
                                        </StackPanel>

                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#36141821" BorderBrush="#3AFFFFFF"
                                                BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,5,0">
                                            <StackPanel>
                                                <TextBlock Text="osu! STAR RATING" Style="{StaticResource MetadataLabelStyle}"/>
                                                <TextBlock Text="{Binding Overview.OsuStarRatingDisplay}" Foreground="White" FontSize="21" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="#44151A21" BorderBrush="#66FF2E93"
                                                BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="5,0,0,0">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="BEATINSIGHT RATING V2" Style="{StaticResource MetadataLabelStyle}"/>
                                                    <TextBlock Text="{Binding Overview.BeatInsightRatingDisplay}" Foreground="{StaticResource AccentMagentaBrush}" FontSize="21" FontWeight="Bold"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Overview.BeatInsightRatingConfidenceDisplay}" HorizontalAlignment="Right"
                                                           VerticalAlignment="Bottom" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,10,10">
                        <Grid.RowDefinitions><RowDefinition Height="1.35*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource DashboardCardStyle}" Margin="0,0,0,5">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="SKILL ANALYSIS" Style="{StaticResource SectionHeadingStyle}"/>
                                <ItemsControl Grid.Row="1"
                                              ItemsSource="{Binding Overview.SkillMetrics}"
                                              Margin="0,7,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:SkillBarControl Margin="0,5,14,5"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource DashboardCardStyle}" Margin="0,5,0,0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="GAMEPLAY IDENTITY V3" Style="{StaticResource SectionHeadingStyle}"/>
                                    <TextBlock Text="{Binding Overview.Identity.GlobalConfidenceDisplay}" HorizontalAlignment="Right"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                </Grid>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,9,0,7">
                                    <Border Background="#25131B" BorderBrush="{Binding Overview.Identity.PrimaryStructure, Converter={StaticResource StructureToBrushConverter}}"
                                            BorderThickness="1" CornerRadius="7" Padding="9,5">
                                        <TextBlock Text="{Binding Overview.Identity.PrimaryStructure}"
                                                   Foreground="{Binding Overview.Identity.PrimaryStructure, Converter={StaticResource StructureToBrushConverter}}"
                                                   FontSize="12" FontWeight="Bold"/>
                                    </Border>
                                    <Border Background="#201419" BorderBrush="{Binding Overview.Identity.SecondaryStructure, Converter={StaticResource StructureToBrushConverter}}"
                                            BorderThickness="1" CornerRadius="7" Padding="9,5" Margin="7,0,0,0"
                                            Visibility="{Binding Overview.Identity.HasSecondary, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Overview.Identity.SecondaryStructure}"
                                                   Foreground="{Binding Overview.Identity.SecondaryStructure, Converter={StaticResource StructureToBrushConverter}}"
                                                   FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding Overview.Identity.MainSkills}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#25171F" CornerRadius="6" Padding="7,3" Margin="0,0,5,0">
                                                        <TextBlock FontSize="10" Foreground="White"><Run Text="{Binding Name}"/><Run Text=" "/><Run Text="{Binding ScoreDisplay}" Foreground="{StaticResource AccentMagentaBrush}"/></TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <StackPanel Grid.Row="1" Margin="0,5,0,0">
                                        <TextBlock Text="DOMINANT PATTERNS"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="8.5"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,4"
                                                   Visibility="{Binding Overview.Patterns.DominantPatterns, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"/>
                                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding Overview.Patterns.DominantPatterns}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#181A22" BorderBrush="#2B2E3A" BorderThickness="1" CornerRadius="6" Padding="7,3" Margin="0,0,5,0">
                                                            <TextBlock FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}">
                                                                <Run Text="{Binding Name, Mode=OneWay}"/>
                                                                <Run Text=" "/>
                                                                <Run Text="{Binding DominantValueDisplay, Mode=OneWay}" Foreground="{StaticResource AccentMagentaBrush}"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource DashboardCardStyle}"
                            Margin="0,0,0,10" BorderBrush="#55FF2E93">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="BIA-CHAN" Style="{StaticResource SectionHeadingStyle}"/>
                                <Border HorizontalAlignment="Right" Background="#2B1822" CornerRadius="7" Padding="8,3">
                                    <TextBlock Text="{Binding Overview.Assistant.StatusBadge}" Foreground="{StaticResource AccentMagentaBrush}" FontSize="9.5" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                            <Grid Grid.Row="1" x:Name="BiaMainVisualHost" Margin="0,8,0,5">
                                <Border Background="#181018"
                                        BorderBrush="#44FF2E93"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="3">
                                    <Image Source="{Binding Overview.Assistant.ImageSource}"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           MaxHeight="245"/>
                                </Border>
                            </Grid>
                            <Border Grid.Row="2" Background="#18151D" CornerRadius="10" Padding="11,9">
