                            Padding="11,6"
                            Background="#25131B"
                            BorderBrush="{Binding Sections.SelectedSection.Structure, Converter={StaticResource StructureToBrushConverter}}"
                            BorderThickness="1"
                            CornerRadius="7">

                                            <TextBlock Text="{Binding Sections.SelectedSection.Structure}"
                                   Foreground="{Binding Sections.SelectedSection.Structure, Converter={StaticResource StructureToBrushConverter}}"
                                   FontSize="12"
                                   FontWeight="Bold"/>
                                        </Border>

                                        <TextBlock Margin="0,16,0,0"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Text="DOMINANT SIGNAL"/>

                                        <TextBlock Text="{Binding Sections.SelectedSection.DominantSignal}"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                        Background="#181A22"
                        BorderBrush="#302C2E3A"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14"
                        Margin="14,0,0,0">

                                        <StackPanel VerticalAlignment="Center">

                                            <TextBlock Text="LOCAL DIFFICULTY"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                                            <TextBlock Text="{Binding Sections.SelectedSection.LocalDifficultyDisplay}"
                                   Foreground="{StaticResource AccentMagentaBrush}"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,7,0,0"/>

                                            <TextBlock Text="/ 100"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="10"
                                   HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="2"
                  Margin="0,14,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                        Content="‹ Previous"
                        Style="{StaticResource ActionPillButtonStyle}"
                        IsEnabled="{Binding Sections.CanGoPrevious}"
                        Click="PreviousSectionButton_Click"/>

                                    <Button Grid.Column="2"
                        Content="Next ›"
                        Style="{StaticResource ActionPillButtonStyle}"
                        IsEnabled="{Binding Sections.CanGoNext}"
                        Click="NextSectionButton_Click"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- LOCAL PRESSURE -->

                        <Border Grid.Column="1"
            Style="{StaticResource DashboardCardStyle}">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="LOCAL PRESSURE"
                       Style="{StaticResource SectionHeadingStyle}"/>

                                <StackPanel Grid.Row="1"
                        Margin="0,15,0,0">

                                    <Grid Margin="0,0,0,13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Jump"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"/>

                                        <TextBlock Grid.Column="1"
                               Text="{Binding Sections.SelectedSection.JumpScore, StringFormat={}{0:F1} / 100}"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="Bold"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Stream"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"/>

                                        <TextBlock Grid.Column="1"
                               Text="{Binding Sections.SelectedSection.StreamScore, StringFormat={}{0:F1} / 100}"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="Bold"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Tech"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"/>

                                        <TextBlock Grid.Column="1"
                               Text="{Binding Sections.SelectedSection.TechScore, StringFormat={}{0:F1} / 100}"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="Bold"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Burst"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"/>

                                        <TextBlock Grid.Column="1"
                               Text="{Binding Sections.SelectedSection.BurstScore, StringFormat={}{0:F1} / 100}"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="Bold"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                </Grid>

                <!-- ===================================================== -->
                <!-- DIFFICULTY TAB                                        -->
                <!-- ===================================================== -->

                <Grid Visibility="{Binding IsDifficultyTabActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="0.85*"/>
                        <RowDefinition Height="1.15*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="2,0,0,12">
                        <TextBlock Text="DIFFICULTY ANALYSIS"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="20"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Global rating, snapshot components and section difficulty distribution"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="10.5"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="1.6*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource DashboardCardStyle}"
                                BorderBrush="#55FF2E93"
                                Margin="0,0,8,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="GLOBAL DIFFICULTY" Style="{StaticResource SectionHeadingStyle}"/>
                                <Grid Grid.Row="1" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="BEATINSIGHT RATING V2"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="DifficultyRatingV2Text"
                                                   Text="{Binding Overview.BeatInsightRatingDisplay}"
                                                   Foreground="{StaticResource AccentMagentaBrush}"
                                                   FontSize="38"
                                                   FontWeight="Bold"
                                                   Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding Overview.BeatInsightRatingConfidenceDisplay, StringFormat=Confidence {0}}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="10"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Background="#181A22"
                                            BorderBrush="#302C2E3A"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12"
                                            Margin="10,0,0,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="osu! STAR RATING"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="DifficultyOsuStarRatingText"
                                                       Text="{Binding Overview.OsuStarRatingDisplay}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="23"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,7,0,0"/>
                                            <TextBlock Text="Official osu! difficulty reference"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="8.5"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1"
                                Style="{StaticResource DashboardCardStyle}"
                                Margin="8,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="RATING BREAKDOWN" Style="{StaticResource SectionHeadingStyle}"/>
                                    <TextBlock Text="Values copied directly from Rating V2 in the snapshot"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="9.5"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <TextBlock Text="Rating V2 breakdown unavailable"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontStyle="Italic"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding Overview.Difficulty.HasRatingBreakdown, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>
                                    <ItemsControl ItemsSource="{Binding Overview.Difficulty.RatingBreakdown}"
                                                  Visibility="{Binding Overview.Difficulty.HasRatingBreakdown, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#181A22"
                                                        BorderBrush="#302C2E3A"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="9,7"
                                                        Margin="3">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="9.5"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding ValueDisplay}"
                                                                   Foreground="{StaticResource AccentMagentaBrush}"
                                                                   FontSize="13"
                                                                   FontWeight="Bold"
                                                                   Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.45*"/>
                            <ColumnDefinition Width="0.95*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource DashboardCardStyle}"
                                Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                    <TextBlock Text="DIFFICULTY DISTRIBUTION / SPIKES" Style="{StaticResource SectionHeadingStyle}"/>
                                    <TextBlock Text="LocalDifficultyScore across Section Analysis V2"
                                           Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="9.5"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                                <Grid Grid.Row="1" Margin="0,10,0,7">
                                <controls:SpikeGraphControl Points="{Binding Overview.DifficultyPoints}"
                                                            Visibility="{Binding Overview.HasDifficultyData, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="No difficulty data available"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding Overview.HasDifficultyData, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>
                            </Grid>
                            <TextBlock Grid.Row="2"
                                       Text="{Binding Overview.SpikesSummaryText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="10.5"
                                       TextAlignment="Center"/>
                        </Grid>
                    </Border>

                        <Border Grid.Column="1"
                                Style="{StaticResource DashboardCardStyle}"
                                Margin="8,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="TOP DIFFICULT SECTIONS" Style="{StaticResource SectionHeadingStyle}"/>
                                    <TextBlock Text="Highest existing LocalDifficultyScore values"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="9.5"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <TextBlock Text="No section difficulty available"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontStyle="Italic"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding Overview.Difficulty.HasTopSections, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Visibility="{Binding Overview.Difficulty.HasTopSections, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ItemsControl ItemsSource="{Binding Overview.Difficulty.TopSections}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#181A22"
                                                            BorderBrush="#302C2E3A"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="9,6"
                                                            Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding SectionNumberDisplay}"
                                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                                               FontSize="10.5"
                                                                               FontWeight="SemiBold"/>
                                                                    <Border Background="#35111D"
                                                                            CornerRadius="5"
                                                                            Padding="5,1"
                                                                            Margin="6,0,0,0"
                                                                            Visibility="{Binding IsSpike, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <TextBlock Text="SPIKE"
                                                                                   Foreground="{StaticResource AccentMagentaBrush}"
                                                                                   FontSize="8"
                                                                                   FontWeight="Bold"/>
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding TimeRangeDisplay}"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           FontSize="8.5"
                                                                           Margin="0,2,0,0"/>
                                                                <TextBlock Text="{Binding Structure}"
                                                                           Foreground="{Binding Structure, Converter={StaticResource StructureToBrushConverter}}"
                                                                           FontSize="9"
                                                                           Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding LocalDifficultyDisplay, StringFormat={}{0} / 100}"
                                                                       Foreground="{StaticResource AccentMagentaBrush}"
                                                                       FontSize="13"
                                                                       FontWeight="Bold"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===================================================== -->
                <!-- NO BEATMAP OVERLAY                                    -->
                <!-- ===================================================== -->

                <Border Background="#E80E0F14" CornerRadius="14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Overview.HasBeatmap}" Value="False"/>
                                        <Condition Binding="{Binding Overview.IsLoading}" Value="False"/>
                                        <Condition Binding="{Binding Overview.HasError}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="/Assets/Brand/BeatInsightLogo.png" Width="82" Height="82" Opacity="0.75"/>
                        <TextBlock Text="No beatmap selected" Foreground="White" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        <TextBlock Text="Select or play a beatmap to open its Overview."
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="OverviewLoadingOverlay" Background="#F20E0F14" CornerRadius="14"
                        Visibility="{Binding Overview.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="220" Height="4" IsIndeterminate="True"
                                     Foreground="{StaticResource AccentMagentaBrush}" Background="#242632"/>
                        <TextBlock Text="{Binding Overview.LoadingMessage}" Foreground="White" FontSize="14"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#F20E0F14" CornerRadius="14"
                        Visibility="{Binding Overview.HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
                        <TextBlock Text="!" Foreground="{StaticResource StatusErrorBrush}" FontSize="38"
                                   FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Overview unavailable" Foreground="White" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding Overview.ErrorMessage}" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border x:Name="SettingsDismissLayer"
                Grid.Row="1"
                Panel.ZIndex="900"
                Background="#01000000"
                Visibility="Collapsed"
                MouseLeftButtonDown="SettingsDismissLayer_MouseLeftButtonDown"/>

        <Border x:Name="SettingsPanel"
                Grid.RowSpan="2"
                Panel.ZIndex="901"
                Width="390"
                MaxHeight="650"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,92,188,0"
                Padding="18"
                Background="#F414151C"
                BorderBrush="#66FF2E93"
                BorderThickness="1"
                CornerRadius="16"
                Visibility="Collapsed"
                MouseLeftButtonDown="SettingsPanel_MouseLeftButtonDown">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel>
                        <TextBlock Text="SETTINGS"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Library and optional community API"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="10"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Content="×"
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            FontSize="16"
                            Cursor="Hand"
                            Click="CloseSettingsButton_Click"/>
                </Grid>

                <Border Grid.Row="1"
                        Background="#171820"
                        BorderBrush="#2B2D39"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="11,8"
                        Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="SONGS FOLDER"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Library.SongsFolderText}"
                                   ToolTip="{Binding Library.SongsFolderText}"
                                   Foreground="White"
                                   FontSize="11"
                                   Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="Change Folder"
                            Style="{StaticResource ActionPillButtonStyle}"
                            IsEnabled="{Binding Library.CanChangeFolder}"
                            Margin="0,0,5,0"
                            Click="ChangeSongsFolderButton_Click"/>
                    <Button Grid.Column="1"
                            Content="Scan Library"
                            Style="{StaticResource ActionPillButtonStyle}"
                            IsEnabled="{Binding Library.CanScan}"
                            Margin="5,0,0,0"
                            Click="ScanLibraryButton_Click"/>
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,14,0,0">
                    <Grid>
                        <TextBlock Text="{Binding Library.StatusText}"
                                   Foreground="White"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Library.ProgressPercentText}"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource AccentMagentaBrush}"
                                   FontSize="10"
                                   Visibility="{Binding Library.HasProgress, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>

                    <ProgressBar Height="5"
                                 Margin="0,8,0,0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding Library.ProgressValue, Mode=OneWay}"
                                 Foreground="{StaticResource AccentMagentaBrush}"
                                 Background="#242632"
                                 Visibility="{Binding Library.HasProgress, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <UniformGrid Columns="2"
                                 Margin="0,10,0,0"
                                 Visibility="{Binding Library.HasProgress, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding Library.ProcessedText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,8,5"/>
                        <TextBlock Text="{Binding Library.AnalyzedText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding Library.UpToDateText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,8,5"/>
                        <TextBlock Text="{Binding Library.UnsupportedText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding Library.FailedText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,8,0"/>
                    </UniformGrid>

                    <TextBlock Text="{Binding Library.CurrentFileText}"
                               ToolTip="{Binding Library.CurrentFileToolTip}"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="9.5"
                               Margin="0,7,0,0"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Library.HasProgress, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Button Content="Cancel Scan"
                            Style="{StaticResource ActionPillButtonStyle}"
                            IsEnabled="{Binding Library.CanCancel}"
                            HorizontalAlignment="Stretch"
                            Margin="0,12,0,0"
                            Visibility="{Binding Library.IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="CancelLibraryScanButton_Click"/>
                </StackPanel>

                <Border Grid.Row="4"
                        Background="#171820"
                        BorderBrush="#2B2D39"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="12"
                        Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="OSU! API"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="Bold"/>
                        <TextBlock Text="BeatInsight uses your personal osu! API credentials for Community Tags and Community Discovery."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,10"/>

                        <TextBlock Text="CLIENT ID"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>
                        <TextBox x:Name="OsuClientIdTextBox"
                                 Text="{Binding OsuApiSettings.ClientId, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#20222C"
                                 Foreground="White"
                                 BorderBrush="#3A3D4B"
                                 Padding="8,6"
                                 Margin="0,4,0,9"/>

                        <TextBlock Text="CLIENT SECRET"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>
                        <PasswordBox x:Name="OsuClientSecretPasswordBox"
                                     Background="#20222C"
                                     Foreground="White"
                                     BorderBrush="#3A3D4B"
                                     Padding="8,6"
                                     Margin="0,4,0,10"/>

                        <UniformGrid Columns="2">
                            <Button x:Name="SaveOsuApiCredentialsButton"
                                    Content="Save credentials"
                                    Style="{StaticResource ActionPillButtonStyle}"
                                    Margin="0,0,5,0"
                                    IsEnabled="{Binding OsuApiSettings.CanEdit}"
                                    Click="SaveOsuApiCredentialsButton_Click"/>
                            <Button x:Name="TestOsuApiConnectionButton"
                                    Content="Test connection"
                                    Style="{StaticResource ActionPillButtonStyle}"
                                    Margin="5,0,0,0"
                                    IsEnabled="{Binding OsuApiSettings.CanEdit}"
                                    Click="TestOsuApiConnectionButton_Click"/>
                        </UniformGrid>
                        <Button x:Name="RemoveOsuApiCredentialsButton"
                                Content="Remove credentials"
                                Style="{StaticResource ActionPillButtonStyle}"
                                Margin="0,8,0,0"
                                IsEnabled="{Binding OsuApiSettings.CanEdit}"
                                Click="RemoveOsuApiCredentialsButton_Click"/>

                        <TextBlock Margin="0,10,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="10">
                            <Run Text="Status: "/>
                            <Run Text="{Binding OsuApiSettings.StatusText, Mode=OneWay}"
                                 FontWeight="SemiBold"/>
                        </TextBlock>

                        <Button x:Name="CreateOsuOAuthApplicationButton"
                                Content="Create osu! OAuth application"
                                Style="{StaticResource ActionPillButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Margin="0,10,0,0"
                                Click="CreateOsuOAuthApplicationButton_Click"/>
                        <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="9.5"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Text="1. Create an OAuth application on osu!&#x0a;2. Leave the callback URL blank for Client Credentials&#x0a;3. Copy its Client ID and Client Secret here&#x0a;4. Save, then test the connection"/>
                    </StackPanel>
                </Border>
            </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
