<UserControl x:Class="BeatInsight.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BeatInsight.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1400"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="DashboardCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="Background" Value="#F0121319"/>
            <Setter Property="BorderBrush" Value="#302C2E3A"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="MetadataLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="MetadataValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="104"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="18,14,18,8"
                Background="#F0121318"
                BorderBrush="#44FF2E93"
                BorderThickness="1"
                CornerRadius="18"
                Padding="16,8"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <Image Source="/Assets/Brand/BeatInsightLogo.png"
                           Width="48"
                           Height="48"
                           Stretch="Uniform"/>
                    <TextBlock Margin="13,0,0,0"
                               FontSize="26"
                               FontWeight="Bold"
                               VerticalAlignment="Center">
                        <Run Text="Beat" Foreground="White"/>
                        <Run Text="Insight" Foreground="#FF2E93"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button Content="Overview" Margin="4,0" Padding="14,8" MinWidth="76"
                            Foreground="White" Background="#35111D" BorderBrush="#FF2E93"
                            BorderThickness="1" FontSize="12" Cursor="Hand"/>
                    <Button Content="Skills" Margin="4,0" Padding="14,8" MinWidth="64"
                            Foreground="#C8CAD3" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="1" FontSize="12" Cursor="Hand"/>
                    <Button Content="Sections" Margin="4,0" Padding="14,8" MinWidth="72"
                            Foreground="#C8CAD3" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="1" FontSize="12" Cursor="Hand"/>
                    <Button Content="Identity" Margin="4,0" Padding="14,8" MinWidth="68"
                            Foreground="#C8CAD3" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="1" FontSize="12" Cursor="Hand"/>
                    <Button Content="Difficulty" Margin="4,0" Padding="14,8" MinWidth="78"
                            Foreground="#C8CAD3" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="1" FontSize="12" Cursor="Hand"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Margin="8,0">
                    <Button x:Name="SettingsButton"
                            Width="34" Height="34" Margin="0,0,8,0" Background="Transparent"
                            BorderThickness="0" Foreground="White" FontSize="18" Cursor="Hand" Content="⚙"
                            Click="SettingsButton_Click"/>
                    <Button Width="30" Height="30" Background="Transparent" BorderThickness="0"
                            Foreground="#C8CAD3" FontSize="15" Cursor="Hand" Content="—"
                            Click="MinimizeButton_Click"/>
                    <Button Width="30" Height="30" Background="Transparent" BorderThickness="0"
                            Foreground="#C8CAD3" FontSize="13" Cursor="Hand" Content="□"
                            Click="MaximizeButton_Click"/>
                    <Button Width="30" Height="30" Background="Transparent" BorderThickness="0"
                            Foreground="#C8CAD3" FontSize="17" Cursor="Hand" Content="×"
                            Click="CloseButton_Click"/>
                </StackPanel>

                <Border Grid.Column="3"
                        Width="205"
                        Height="58"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="#24151A20"
                        BorderBrush="#332F3340"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="8"
                        Margin="8,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="40" Height="40"
                                 Stroke="#FF2E93" StrokeThickness="2">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding Overview.Assistant.ImageSource}"
                                            Stretch="UniformToFill"
                                            AlignmentX="Center"
                                            AlignmentY="Center"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Overview.Assistant.Name}" Foreground="White"
                                       FontSize="13" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Overview.Assistant.Title}" Foreground="#8F94A3" FontSize="9.5"/>
                        </StackPanel>
                        <Ellipse Grid.Column="2" Width="8" Height="8" Fill="#44E36C"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18,8,18,18">
            <Border Background="#0E0F14" BorderBrush="#221F2230" BorderThickness="1" CornerRadius="16"/>

            <Grid Margin="10">
                <Grid Visibility="{Binding Overview.HasBeatmap, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.45*"/>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="0.8*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0"
                            Style="{StaticResource DashboardCardStyle}"
                            Margin="0,0,10,10" Padding="0" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding Overview.BackgroundPath}"
                                   Stretch="UniformToFill" Opacity="0.4"
                                   Visibility="{Binding Overview.HasBackground, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#F70E0F14" Offset="0"/>
                                        <GradientStop Color="#D50E0F14" Offset="0.58"/>
                                        <GradientStop Color="#B3171119" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <Grid Margin="20,17">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="BEATMAP INFORMATION" Style="{StaticResource SectionHeadingStyle}"/>

                                <StackPanel Grid.Row="1" Margin="0,12,0,8">
                                    <TextBlock x:Name="OverviewTitleText" Text="{Binding Overview.Title}" Foreground="White" FontSize="26"
                                               FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Overview.Artist}" Foreground="#D8DAE2" FontSize="15"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Margin="0,10,0,0">
                                        <Border Background="#35111D" BorderBrush="#66FF2E93" BorderThickness="1"
                                                CornerRadius="7" Padding="10,5" HorizontalAlignment="Left">
                                            <TextBlock x:Name="OverviewDifficultyText" Text="{Binding Overview.Version}" Foreground="White" FontSize="11"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                                        </Border>
                                        <ItemsControl Margin="0,7,0,0"
                                                      ItemsSource="{Binding Overview.CommunityTags}"
                                                      Visibility="{Binding Overview.HasCommunityTags, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#24141D"
                                                            BorderBrush="#55FF2E93"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="7,3"
                                                            Margin="0,0,6,5">
                                                        <TextBlock FontSize="9.5" Foreground="#E7E8EE">
                                                            <Run Text="{Binding Name}"/>
                                                            <Run Text="  "/>
                                                            <Run Text="{Binding Votes}" Foreground="{StaticResource TextMutedBrush}"/>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Margin="0,4,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11">
                                            <Run Text="mapped by "/>
                                            <Run Text="{Binding Overview.Creator}" FontWeight="SemiBold" Foreground="White"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <UniformGrid Grid.Row="0" Columns="6" Margin="0,0,0,10">
                                        <StackPanel><TextBlock Text="BPM" Style="{StaticResource MetadataLabelStyle}"/><TextBlock Text="{Binding Overview.Bpm}" Style="{StaticResource MetadataValueStyle}"/></StackPanel>
                                        <StackPanel><TextBlock Text="LENGTH" Style="{StaticResource MetadataLabelStyle}"/><TextBlock Text="{Binding Overview.LengthDisplay}" Style="{StaticResource MetadataValueStyle}"/></StackPanel>
                                        <StackPanel><TextBlock Text="AR" Style="{StaticResource MetadataLabelStyle}"/><TextBlock Text="{Binding Overview.Ar, StringFormat={}{0:F1}}" Style="{StaticResource MetadataValueStyle}"/></StackPanel>
                                        <StackPanel><TextBlock Text="OD" Style="{StaticResource MetadataLabelStyle}"/><TextBlock Text="{Binding Overview.Od, StringFormat={}{0:F1}}" Style="{StaticResource MetadataValueStyle}"/></StackPanel>
                                        <StackPanel><TextBlock Text="CS" Style="{StaticResource MetadataLabelStyle}"/><TextBlock Text="{Binding Overview.Cs, StringFormat={}{0:F1}}" Style="{StaticResource MetadataValueStyle}"/></StackPanel>
                                        <StackPanel><TextBlock Text="HP" Style="{StaticResource MetadataLabelStyle}"/><TextBlock Text="{Binding Overview.Hp, StringFormat={}{0:F1}}" Style="{StaticResource MetadataValueStyle}"/></StackPanel>
                                    </UniformGrid>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#36141821" BorderBrush="#3AFFFFFF"
                                                BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,5,0">
                                            <StackPanel>
                                                <TextBlock Text="osu! STAR RATING" Style="{StaticResource MetadataLabelStyle}"/>
                                                <TextBlock Text="{Binding Overview.OsuStarRatingDisplay}" Foreground="White" FontSize="21" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="#44151A21" BorderBrush="#66FF2E93"
                                                BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="5,0,0,0">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="BEATINSIGHT RATING V2" Style="{StaticResource MetadataLabelStyle}"/>
                                                    <TextBlock Text="{Binding Overview.BeatInsightRatingDisplay}" Foreground="{StaticResource AccentMagentaBrush}" FontSize="21" FontWeight="Bold"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Overview.BeatInsightRatingConfidenceDisplay}" HorizontalAlignment="Right"
                                                           VerticalAlignment="Bottom" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,10,10">
                        <Grid.RowDefinitions><RowDefinition Height="1.35*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource DashboardCardStyle}" Margin="0,0,0,5">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="SKILL ANALYSIS" Style="{StaticResource SectionHeadingStyle}"/>
                                <Grid Grid.Row="1" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <controls:SkillBarControl Grid.Row="0" Grid.Column="0" Margin="0,0,0,11" DataContext="{Binding Overview.SkillMetrics[0]}"/>
                                    <controls:SkillBarControl Grid.Row="0" Grid.Column="2" Margin="0,0,0,11" DataContext="{Binding Overview.SkillMetrics[1]}"/>
                                    <controls:SkillBarControl Grid.Row="1" Grid.Column="0" Margin="0,0,0,11" DataContext="{Binding Overview.SkillMetrics[2]}"/>
                                    <controls:SkillBarControl Grid.Row="1" Grid.Column="2" Margin="0,0,0,11" DataContext="{Binding Overview.SkillMetrics[3]}"/>
                                    <controls:SkillBarControl Grid.Row="2" Grid.Column="0" Margin="0,0,0,11" DataContext="{Binding Overview.SkillMetrics[4]}"/>
                                    <controls:SkillBarControl Grid.Row="2" Grid.Column="2" Margin="0,0,0,11" DataContext="{Binding Overview.SkillMetrics[5]}"/>
                                    <controls:SkillBarControl Grid.Row="3" Grid.Column="0" DataContext="{Binding Overview.SkillMetrics[6]}"/>
                                    <controls:SkillBarControl Grid.Row="3" Grid.Column="2" DataContext="{Binding Overview.SkillMetrics[7]}"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource DashboardCardStyle}" Margin="0,5,0,0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="GAMEPLAY IDENTITY V3" Style="{StaticResource SectionHeadingStyle}"/>
                                    <TextBlock Text="{Binding Overview.Identity.GlobalConfidenceDisplay}" HorizontalAlignment="Right"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                </Grid>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,9,0,7">
                                    <Border Background="#25131B" BorderBrush="{Binding Overview.Identity.PrimaryStructure, Converter={StaticResource StructureToBrushConverter}}"
                                            BorderThickness="1" CornerRadius="7" Padding="9,5">
                                        <TextBlock Text="{Binding Overview.Identity.PrimaryStructure}"
                                                   Foreground="{Binding Overview.Identity.PrimaryStructure, Converter={StaticResource StructureToBrushConverter}}"
                                                   FontSize="12" FontWeight="Bold"/>
                                    </Border>
                                    <Border Background="#201419" BorderBrush="{Binding Overview.Identity.SecondaryStructure, Converter={StaticResource StructureToBrushConverter}}"
                                            BorderThickness="1" CornerRadius="7" Padding="9,5" Margin="7,0,0,0"
                                            Visibility="{Binding Overview.Identity.HasSecondary, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Overview.Identity.SecondaryStructure}"
                                                   Foreground="{Binding Overview.Identity.SecondaryStructure, Converter={StaticResource StructureToBrushConverter}}"
                                                   FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding Overview.Identity.MainSkills}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#25171F" CornerRadius="6" Padding="7,3" Margin="0,0,5,0">
                                                        <TextBlock FontSize="10" Foreground="White"><Run Text="{Binding Name}"/><Run Text=" "/><Run Text="{Binding ScoreDisplay}" Foreground="{StaticResource AccentMagentaBrush}"/></TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <ScrollViewer Grid.Row="1" Margin="0,5,0,0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding Overview.Identity.MainPatterns}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#181A22" BorderBrush="#2B2E3A" BorderThickness="1" CornerRadius="6" Padding="7,3" Margin="0,0,5,0">
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9.5"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource DashboardCardStyle}"
                            Margin="0,0,0,10" BorderBrush="#55FF2E93">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="BIA-CHAN" Style="{StaticResource SectionHeadingStyle}"/>
                                <Border HorizontalAlignment="Right" Background="#2B1822" CornerRadius="7" Padding="8,3">
                                    <TextBlock Text="{Binding Overview.Assistant.StatusBadge}" Foreground="{StaticResource AccentMagentaBrush}" FontSize="9.5" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                            <Grid Grid.Row="1" x:Name="BiaMainVisualHost" Margin="0,8,0,5">
                                <Border Background="#181018"
                                        BorderBrush="#44FF2E93"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="3">
                                    <Image Source="{Binding Overview.Assistant.ImageSource}"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           MaxHeight="245"/>
                                </Border>
                            </Grid>
                            <Border Grid.Row="2" Background="#18151D" CornerRadius="10" Padding="11,9">
                                <TextBlock Text="{Binding Overview.Assistant.Message}" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="10.5" TextWrapping="Wrap" MaxHeight="58" TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                            Style="{StaticResource DashboardCardStyle}" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="SECTION ANALYSIS V2" Style="{StaticResource SectionHeadingStyle}"/>
                                <TextBlock Text="{Binding Overview.SpikesSummaryText}" HorizontalAlignment="Right"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                <TextBlock Text="No section data available" Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding Overview.Sections, Converter={StaticResource InvertedNullOrEmptyToVisibilityConverter}}"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                              Visibility="{Binding Overview.Sections, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                                    <ItemsControl ItemsSource="{Binding Overview.Sections}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="74" MinHeight="92" Background="#15171E"
                                                        BorderBrush="{Binding Structure, Converter={StaticResource StructureToBrushConverter}}"
                                                        BorderThickness="1,3,1,1" CornerRadius="8" Padding="8" Margin="0,0,7,0"
                                                        ToolTip="{Binding TooltipText}">
                                                    <Grid>
                                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                        <TextBlock Text="{Binding TimeRangeDisplay}" Foreground="{StaticResource TextMutedBrush}" FontSize="8.5" TextAlignment="Center"/>
                                                        <TextBlock Grid.Row="1" Text="{Binding Structure}"
                                                                   Foreground="{Binding Structure, Converter={StaticResource StructureToBrushConverter}}"
                                                                   FontSize="10" FontWeight="Bold" TextAlignment="Center" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Row="2" Text="{Binding LocalDifficultyDisplay}" Foreground="White"
                                                                   FontSize="16" FontWeight="Bold" TextAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource DashboardCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="DIFFICULTY SPIKES" Style="{StaticResource SectionHeadingStyle}"/>
                            <Grid Grid.Row="1" Margin="0,10,0,6" MinHeight="90">
                                <controls:SpikeGraphControl Points="{Binding Overview.DifficultyPoints}"
                                                            Visibility="{Binding Overview.DifficultyPoints, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"/>
                                <TextBlock Text="No difficulty data available"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding Overview.DifficultyPoints, Converter={StaticResource InvertedNullOrEmptyToVisibilityConverter}}"/>
                            </Grid>
                            <TextBlock Grid.Row="2" Text="{Binding Overview.SpikesSummaryText}"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="9.5"
                                       TextWrapping="Wrap" TextAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <Border Background="#E80E0F14" CornerRadius="14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Overview.HasBeatmap}" Value="False"/>
                                        <Condition Binding="{Binding Overview.IsLoading}" Value="False"/>
                                        <Condition Binding="{Binding Overview.HasError}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="/Assets/Brand/BeatInsightLogo.png" Width="82" Height="82" Opacity="0.75"/>
                        <TextBlock Text="No beatmap selected" Foreground="White" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        <TextBlock Text="Select or play a beatmap to open its Overview."
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#F20E0F14" CornerRadius="14"
                        Visibility="{Binding Overview.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="220" Height="4" IsIndeterminate="True"
                                     Foreground="{StaticResource AccentMagentaBrush}" Background="#242632"/>
                        <TextBlock Text="{Binding Overview.LoadingMessage}" Foreground="White" FontSize="14"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#F20E0F14" CornerRadius="14"
                        Visibility="{Binding Overview.HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
                        <TextBlock Text="!" Foreground="{StaticResource StatusErrorBrush}" FontSize="38"
                                   FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Overview unavailable" Foreground="White" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding Overview.ErrorMessage}" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border x:Name="SettingsDismissLayer"
                Grid.Row="1"
                Panel.ZIndex="900"
                Background="#01000000"
                Visibility="Collapsed"
                MouseLeftButtonDown="SettingsDismissLayer_MouseLeftButtonDown"/>

        <Border x:Name="SettingsPanel"
                Grid.RowSpan="2"
                Panel.ZIndex="901"
                Width="390"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,92,188,0"
                Padding="18"
                Background="#F414151C"
                BorderBrush="#66FF2E93"
                BorderThickness="1"
                CornerRadius="16"
                Visibility="Collapsed"
                MouseLeftButtonDown="SettingsPanel_MouseLeftButtonDown">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel>
                        <TextBlock Text="LIBRARY"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Songs folder and local analysis index"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="10"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Content="×"
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            FontSize="16"
                            Cursor="Hand"
                            Click="CloseSettingsButton_Click"/>
                </Grid>

                <Border Grid.Row="1"
                        Background="#171820"
                        BorderBrush="#2B2D39"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="11,8"
                        Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="SONGS FOLDER"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Library.SongsFolderText}"
                                   ToolTip="{Binding Library.SongsFolderText}"
                                   Foreground="White"
                                   FontSize="11"
                                   Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="Change Folder"
                            Style="{StaticResource ActionPillButtonStyle}"
                            IsEnabled="{Binding Library.CanChangeFolder}"
                            Margin="0,0,5,0"
                            Click="ChangeSongsFolderButton_Click"/>
                    <Button Grid.Column="1"
                            Content="Scan Library"
                            Style="{StaticResource ActionPillButtonStyle}"
                            IsEnabled="{Binding Library.CanScan}"
                            Margin="5,0,0,0"
                            Click="ScanLibraryButton_Click"/>
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,14,0,0">
                    <Grid>
                        <TextBlock Text="{Binding Library.StatusText}"
                                   Foreground="White"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Library.ProgressPercentText}"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource AccentMagentaBrush}"
                                   FontSize="10"
                                   Visibility="{Binding Library.HasProgress, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>

                    <ProgressBar Height="5"
                                 Margin="0,8,0,0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding Library.ProgressValue, Mode=OneWay}"
                                 Foreground="{StaticResource AccentMagentaBrush}"
                                 Background="#242632"
                                 Visibility="{Binding Library.HasProgress, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <UniformGrid Columns="2"
                                 Margin="0,10,0,0"
                                 Visibility="{Binding Library.HasProgress, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding Library.ProcessedText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,8,5"/>
                        <TextBlock Text="{Binding Library.AnalyzedText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding Library.UpToDateText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,8,5"/>
                        <TextBlock Text="{Binding Library.UnsupportedText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding Library.FailedText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,8,0"/>
                    </UniformGrid>

                    <TextBlock Text="{Binding Library.CurrentFileText}"
                               ToolTip="{Binding Library.CurrentFileToolTip}"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="9.5"
                               Margin="0,7,0,0"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Library.HasProgress, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Button Content="Cancel Scan"
                            Style="{StaticResource ActionPillButtonStyle}"
                            IsEnabled="{Binding Library.CanCancel}"
                            HorizontalAlignment="Stretch"
                            Margin="0,12,0,0"
                            Visibility="{Binding Library.IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="CancelLibraryScanButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
