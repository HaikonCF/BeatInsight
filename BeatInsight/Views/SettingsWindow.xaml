<Window x:Class="BeatInsight.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="BeatInsight Settings"
        Width="1100"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppTextPrimaryBrush}"
        PreviewKeyDown="SettingsWindow_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BeatInsight;component/Theming/BeatInsightControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Button" BasedOn="{StaticResource BeatInsightSecondaryButtonStyle}"/>
            <Style TargetType="ComboBox" BasedOn="{StaticResource BeatInsightComboBoxStyle}"/>
            <Style TargetType="CheckBox" BasedOn="{StaticResource BeatInsightCheckBoxStyle}"/>
            <Style TargetType="TextBox" BasedOn="{StaticResource BeatInsightTextBoxStyle}"/>
            <Style TargetType="PasswordBox" BasedOn="{StaticResource BeatInsightPasswordBoxStyle}"/>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource BeatInsightScrollBarStyle}"/>
        </ResourceDictionary>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="14"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="22,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="BeatInsight Settings"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   FontSize="18"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Personalize BeatInsight without interrupting your analysis."
                                   Foreground="{DynamicResource AppTextMutedBrush}"
                                   FontSize="10.5"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Width="36"
                            Height="36"
                            Padding="0"
                            Content="×"
                            FontSize="18"
                            ToolTip="Close settings"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="0,0,1,0"
                        CornerRadius="0,0,0,14"
                        Padding="14,20">
                    <StackPanel>
                        <TextBlock Text="SETTINGS"
                                   Foreground="{DynamicResource AppTextMutedBrush}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="12,0,0,10"/>
                        <RadioButton Content="General"
                                     GroupName="SettingsCategories"
                                     Tag="General"
                                     IsChecked="{Binding IsGeneralSelected, Mode=OneWay}"
                                     Style="{StaticResource SettingsSidebarItemStyle}"
                                     Checked="Category_Checked"/>
                        <RadioButton Content="Overlay"
                                     GroupName="SettingsCategories"
                                     Tag="Overlay"
                                     IsChecked="{Binding IsOverlaySelected, Mode=OneWay}"
                                     Style="{StaticResource SettingsSidebarItemStyle}"
                                     Checked="Category_Checked"/>
                        <RadioButton Content="Appearance"
                                     GroupName="SettingsCategories"
                                     Tag="Appearance"
                                     IsChecked="{Binding IsAppearanceSelected, Mode=OneWay}"
                                     Style="{StaticResource SettingsSidebarItemStyle}"
                                     Checked="Category_Checked"/>
                        <RadioButton Content="Updates"
                                     GroupName="SettingsCategories"
                                     Tag="Updates"
                                     IsChecked="{Binding IsUpdatesSelected, Mode=OneWay}"
                                     Style="{StaticResource SettingsSidebarItemStyle}"
                                     Checked="Category_Checked"/>
                        <RadioButton Content="osu! API"
                                     GroupName="SettingsCategories"
                                     Tag="OsuApi"
                                     IsChecked="{Binding IsOsuApiSelected, Mode=OneWay}"
                                     Style="{StaticResource SettingsSidebarItemStyle}"
                                     Checked="Category_Checked"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" Margin="30,24,24,22">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsGeneralSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel MaxWidth="790" HorizontalAlignment="Left">
                            <TextBlock Text="General" Style="{StaticResource SettingsPageTitleStyle}"/>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Songs library" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                    <TextBlock Text="Choose the osu! Songs folder used by BeatInsight and refresh its local analysis index."
                                               Style="{StaticResource SettingsHelpTextStyle}"/>
                                    <Border Background="{DynamicResource AppSurfaceAltBrush}"
                                            BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="12,9"
                                            Margin="0,14,0,12">
                                        <TextBlock Text="{Binding Library.SongsFolderText}"
                                                   ToolTip="{Binding Library.SongsFolderText}"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Change Folder"
                                                IsEnabled="{Binding Library.CanChangeFolder}"
                                                Click="ChangeSongsFolderButton_Click"/>
                                        <Button Content="Scan Library"
                                                Margin="10,0,0,0"
                                                IsEnabled="{Binding Library.CanScan}"
                                                Style="{StaticResource BeatInsightPrimaryButtonStyle}"
                                                Click="ScanLibraryButton_Click"/>
                                        <Button Content="Cancel Scan"
                                                Margin="10,0,0,0"
                                                IsEnabled="{Binding Library.CanCancel}"
                                                Visibility="{Binding Library.IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Click="CancelLibraryScanButton_Click"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,16,0,0">
                                        <Grid>
                                            <TextBlock Text="{Binding Library.StatusText}"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Library.ProgressPercentText}"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource AppAccentBrush}"
                                                       Visibility="{Binding Library.HasProgress, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </Grid>
                                        <ProgressBar Height="6"
                                                     Margin="0,8,0,0"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding Library.ProgressValue, Mode=OneWay}"
                                                     Foreground="{DynamicResource AppAccentBrush}"
                                                     Background="{DynamicResource AppSurfaceAltBrush}"
                                                     Visibility="{Binding Library.HasProgress, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding Library.CurrentFileText}"
                                                   Style="{StaticResource SettingsHelpTextStyle}"
                                                   Margin="0,7,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Library.HasProgress, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Startup and window" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                    <TextBlock Text="Control how BeatInsight starts and behaves when its main window is closed."
                                               Style="{StaticResource SettingsHelpTextStyle}" Margin="0,0,0,15"/>
                                    <CheckBox Content="Start BeatInsight with Windows"
                                              IsChecked="{Binding WindowLifecycle.StartWithWindows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Margin="0,0,0,12"/>
                                    <CheckBox Content="Start minimized to system tray"
                                              IsChecked="{Binding WindowLifecycle.StartMinimized, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Margin="0,0,0,12"/>
                                    <CheckBox Content="Close BeatInsight to system tray"
                                              IsChecked="{Binding WindowLifecycle.CloseToTray, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsOverlaySelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel MaxWidth="790" HorizontalAlignment="Left">
                            <TextBlock Text="Overlay" Style="{StaticResource SettingsPageTitleStyle}"/>
                            <Border Style="{StaticResource SettingsCardStyle}"
                                    IsEnabled="{Binding OverlaySettings.IsNormalSettingsEnabled}">
                                <StackPanel>
                                    <TextBlock Text="Layout preset" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                    <TextBlock Text="Choose a starting layout, then refine positions with Edit Mode."
                                               Style="{StaticResource SettingsHelpTextStyle}"/>
                                    <ComboBox ItemsSource="{Binding OverlaySettings.Presets}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding OverlaySettings.SelectedPresetId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Margin="0,14,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}"
                                    IsEnabled="{Binding OverlaySettings.IsNormalSettingsEnabled}">
                                <StackPanel>
                                    <TextBlock Text="Gameplay HUD" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                    <TextBlock Text="Select which modules BeatInsight displays during supported gameplay."
                                               Style="{StaticResource SettingsHelpTextStyle}" Margin="0,0,0,15"/>
                                    <UniformGrid Columns="2">
                                        <CheckBox Content="Current Section" IsChecked="{Binding OverlaySettings.ShowCurrentSection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,12"/>
                                        <CheckBox Content="Up Next" IsChecked="{Binding OverlaySettings.ShowUpNext, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                                        <CheckBox Content="Difficulty Timeline" IsChecked="{Binding OverlaySettings.ShowDifficultyTimeline, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,12"/>
                                        <CheckBox Content="Live Patterns" IsChecked="{Binding OverlaySettings.ShowLivePatterns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                                        <CheckBox Content="Live Stats" IsChecked="{Binding OverlaySettings.ShowLiveStats, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0"/>
                                        <CheckBox Content="Performance (PP)" IsChecked="{Binding OverlaySettings.ShowPerformance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Edit overlay layout" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                    <TextBlock Text="Move and resize overlays directly, then save or cancel the edited layout."
                                               Style="{StaticResource SettingsHelpTextStyle}" Margin="0,0,0,14"/>
                                    <Button Content="Edit Overlay Layout"
                                            HorizontalAlignment="Left"
                                            IsEnabled="{Binding OverlaySettings.CanBeginEdit}"
                                            Click="BeginOverlayEditButton_Click"/>
                                    <StackPanel Margin="0,14,0,0"
                                                Visibility="{Binding OverlaySettings.IsOverlayEditMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Drag overlays to move them. Use the corner handle to resize."
                                                   Style="{StaticResource SettingsHelpTextStyle}" Margin="0,0,0,10"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Save" Style="{StaticResource BeatInsightPrimaryButtonStyle}" Click="SaveOverlayEditButton_Click"/>
                                            <Button Content="Cancel" Margin="10,0,0,0" Click="CancelOverlayEditButton_Click"/>
                                            <Button Content="Reset" Margin="10,0,0,0" Style="{StaticResource BeatInsightDangerButtonStyle}" Click="ResetOverlayEditButton_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- FEAT-003 : overlays communautaires tosu! gérés par BeatInsight (un compagnon par overlay). -->
                            <Border x:Name="CommunityOverlaysCard" Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right"
                                                Content="Add overlay…"
                                                VerticalAlignment="Top"
                                                Style="{StaticResource BeatInsightPrimaryButtonStyle}"
                                                IsEnabled="{Binding CommunityOverlays.IsAttached}"
                                                Click="AddCommunityOverlayButton_Click"/>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Community Overlays" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                            <TextBlock Text="Import tosu! overlay folders and run them over osu! with BeatInsight data. Overlay files are never modified."
                                                       Style="{StaticResource SettingsHelpTextStyle}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="The Community Overlays companion is missing next to BeatInsight. Overlays cannot be started."
                                               Foreground="{DynamicResource AppDangerBrush}"
                                               TextWrapping="Wrap" Margin="0,12,0,0"
                                               Visibility="{Binding CommunityOverlays.IsCompanionMissing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding CommunityOverlays.StatusMessage}"
                                               TextWrapping="Wrap" Margin="0,12,0,0"
                                               Visibility="{Binding CommunityOverlays.HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsHelpTextStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CommunityOverlays.IsStatusError}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding CommunityOverlays.Overlays}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,4" Margin="0,6,0,0">
                                                    <StackPanel>
                                                        <DockPanel LastChildFill="True">
                                                            <CheckBox DockPanel.Dock="Right" Content="Enabled" VerticalAlignment="Top"
                                                                      ToolTip="Start this overlay now and every time BeatInsight starts."
                                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                            <StackPanel Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding FolderPath}" ToolTip="{Binding FolderPath}"
                                                                           Style="{StaticResource SettingsHelpTextStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                                <TextBlock Margin="0,4,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                    <Run Text="Status:"/>
                                                                    <Run Text="{Binding StateText, Mode=OneWay}"/>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding MessageText}" Style="{StaticResource SettingsHelpTextStyle}" TextWrapping="Wrap"
                                                                           Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                        <WrapPanel Margin="0,10,0,0">
                                                            <Button Content="Start" Margin="0,0,8,6" IsEnabled="{Binding CanStart}" Click="StartCommunityOverlayButton_Click"/>
                                                            <Button Content="Stop" Margin="0,0,8,6" IsEnabled="{Binding IsActive}" Click="StopCommunityOverlayButton_Click"/>
                                                            <Button Content="Preview" Margin="0,0,8,6" IsEnabled="{Binding CanPreview}"
                                                                    ToolTip="Open the overlay with sample data, without osu!."
                                                                    Click="PreviewCommunityOverlayButton_Click"/>
                                                            <Button Content="{Binding EditButtonText}" Margin="0,0,8,6"
                                                                    ToolTip="Show the move handle and resize grip on the overlay window."
                                                                    Click="EditCommunityOverlayButton_Click"/>
                                                            <Button Content="Remove" Margin="0,0,8,6"
                                                                    Style="{StaticResource BeatInsightDangerButtonStyle}"
                                                                    ToolTip="Remove from BeatInsight. The overlay folder is kept."
                                                                    Click="RemoveCommunityOverlayButton_Click"/>
                                                        </WrapPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                                                            <TextBlock Text="X" Style="{StaticResource SettingsLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <TextBox Text="{Binding XText, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                                            <TextBlock Text="Y" Style="{StaticResource SettingsLabelStyle}" VerticalAlignment="Center" Margin="12,0,6,0"/>
                                                            <TextBox Text="{Binding YText, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                                            <TextBlock Text="W" Style="{StaticResource SettingsLabelStyle}" VerticalAlignment="Center" Margin="12,0,6,0"/>
                                                            <TextBox Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                                            <TextBlock Text="H" Style="{StaticResource SettingsLabelStyle}" VerticalAlignment="Center" Margin="12,0,6,0"/>
                                                            <TextBox Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                                            <Button Content="Apply" Margin="12,0,0,0" Click="ApplyCommunityOverlayBoundsButton_Click"/>
                                                        </StackPanel>
                                                        <!-- FEAT-003.1 : échelle du contenu (zoom WebView2), indépendante de W/H. -->
                                                        <DockPanel Margin="0,4,0,6" LastChildFill="True">
                                                            <TextBlock DockPanel.Dock="Left" Text="SCALE" Style="{StaticResource SettingsLabelStyle}"
                                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                            <Button DockPanel.Dock="Right" Content="Reset 100 %" Margin="12,0,0,0"
                                                                    IsEnabled="{Binding CanResetScale}"
                                                                    Click="ResetCommunityOverlayScaleButton_Click"/>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ScaleText}" Width="52" TextAlignment="Right"
                                                                       VerticalAlignment="Center" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                            <Slider x:Name="CommunityOverlayScaleSlider"
                                                                    Style="{StaticResource BeatInsightSliderStyle}"
                                                                    Minimum="{Binding MinimumScale, Mode=OneTime}"
                                                                    Maximum="{Binding MaximumScale, Mode=OneTime}"
                                                                    TickFrequency="{Binding ScaleStep, Mode=OneTime}"
                                                                    SmallChange="{Binding ScaleStep, Mode=OneTime}"
                                                                    LargeChange="25"
                                                                    Value="{Binding ScalePercent, Mode=TwoWay}"
                                                                    VerticalAlignment="Center"
                                                                    ToolTip="Scales the overlay content. The window size (W/H) does not change."/>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="No community overlay imported yet."
                                               Style="{StaticResource SettingsHelpTextStyle}" Margin="0,12,0,0"
                                               Visibility="{Binding CommunityOverlays.HasNoOverlays, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsAppearanceSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel MaxWidth="790" HorizontalAlignment="Left">
                            <TextBlock Text="Appearance" Style="{StaticResource SettingsPageTitleStyle}"/>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="App theme" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                    <TextBlock Text="Changes the main application and all themed controls."
                                               Style="{StaticResource SettingsHelpTextStyle}"/>
                                    <ComboBox ItemsSource="{Binding OverlaySettings.AppThemes}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding OverlaySettings.SelectedAppThemeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Margin="0,14,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Overlay theme" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                    <TextBlock Text="Controls the visual identity of gameplay overlays independently."
                                               Style="{StaticResource SettingsHelpTextStyle}"/>
                                    <ComboBox ItemsSource="{Binding OverlaySettings.OverlayThemes}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding OverlaySettings.SelectedOverlayThemeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Margin="0,14,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Community Themes" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                        <TextBlock Text="Create, import and edit custom palettes in the existing theme editor."
                                                   Style="{StaticResource SettingsHelpTextStyle}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Community Themes..." Margin="20,0,0,0" Click="CommunityThemesButton_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsUpdatesSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel MaxWidth="790" HorizontalAlignment="Left">
                            <TextBlock Text="Updates" Style="{StaticResource SettingsPageTitleStyle}"/>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="BeatInsight updates" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                    <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,14">
                                        <Run Text="Current version: "/>
                                        <Run Text="{Binding Updates.CurrentVersion, Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <CheckBox Content="Check for updates automatically"
                                              IsChecked="{Binding Updates.CheckAutomatically, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Margin="0,0,0,15"/>
                                    <Border Background="{DynamicResource AppSurfaceAltBrush}"
                                            BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="12">
                                        <TextBlock Text="{Binding Updates.StatusText, Mode=OneWay}"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                    <ProgressBar Height="6"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding Updates.Progress, Mode=OneWay}"
                                                 Foreground="{DynamicResource AppAccentBrush}"
                                                 Background="{DynamicResource AppSurfaceAltBrush}"
                                                 Visibility="{Binding Updates.IsDownloading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 Margin="0,12,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Content="Check for updates"
                                                IsEnabled="{Binding Updates.CanCheck, Mode=OneWay}"
                                                Click="CheckForUpdatesButton_Click"/>
                                        <Button Content="Download"
                                                Margin="10,0,0,0"
                                                Style="{StaticResource BeatInsightPrimaryButtonStyle}"
                                                IsEnabled="{Binding Updates.CanDownload, Mode=OneWay}"
                                                Visibility="{Binding Updates.ShowDownload, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Click="DownloadUpdateButton_Click"/>
                                        <Button Content="Restart and update"
                                                Margin="10,0,0,0"
                                                Style="{StaticResource BeatInsightPrimaryButtonStyle}"
                                                IsEnabled="{Binding Updates.CanRestart, Mode=OneWay}"
                                                Visibility="{Binding Updates.ShowRestart, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Click="RestartAndUpdateButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsOsuApiSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel MaxWidth="790" HorizontalAlignment="Left">
                            <TextBlock Text="osu! API" Style="{StaticResource SettingsPageTitleStyle}"/>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Client credentials" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                    <TextBlock Text="BeatInsight uses your personal osu! API credentials for Community Tags and Community Discovery."
                                               Style="{StaticResource SettingsHelpTextStyle}" Margin="0,0,0,16"/>
                                    <TextBlock Text="CLIENT ID" Style="{StaticResource SettingsLabelStyle}"/>
                                    <TextBox x:Name="OsuClientIdTextBox"
                                             Text="{Binding OsuApiSettings.ClientId, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding OsuApiSettings.CanEdit}"
                                             Margin="0,0,0,14"/>
                                    <TextBlock Text="CLIENT SECRET" Style="{StaticResource SettingsLabelStyle}"/>
                                    <PasswordBox x:Name="OsuClientSecretPasswordBox"
                                                 IsEnabled="{Binding OsuApiSettings.CanEdit}"
                                                 Margin="0,0,0,16"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Save credentials"
                                                Style="{StaticResource BeatInsightPrimaryButtonStyle}"
                                                IsEnabled="{Binding OsuApiSettings.CanEdit}"
                                                Click="SaveOsuApiCredentialsButton_Click"/>
                                        <Button Content="Test connection"
                                                Margin="10,0,0,0"
                                                IsEnabled="{Binding OsuApiSettings.CanEdit}"
                                                Click="TestOsuApiConnectionButton_Click"/>
                                        <Button Content="Remove credentials"
                                                Margin="10,0,0,0"
                                                Style="{StaticResource BeatInsightDangerButtonStyle}"
                                                IsEnabled="{Binding OsuApiSettings.CanEdit}"
                                                Click="RemoveOsuApiCredentialsButton_Click"/>
                                    </StackPanel>
                                    <TextBlock Margin="0,14,0,0" Foreground="{DynamicResource AppTextSecondaryBrush}">
                                        <Run Text="Status: "/>
                                        <Run Text="{Binding OsuApiSettings.StatusText, Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Create an osu! OAuth application" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                        <TextBlock Text="Leave the callback URL blank for Client Credentials, then copy the ID and secret above."
                                                   Style="{StaticResource SettingsHelpTextStyle}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Open osu! settings"
                                            Margin="20,0,0,0"
                                            Click="CreateOsuOAuthApplicationButton_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
