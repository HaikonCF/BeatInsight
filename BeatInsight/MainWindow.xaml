<Window x:Class="BeatInsight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BeatInsight.Controls"
        xmlns:views="clr-namespace:BeatInsight.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"

        Title="{Binding AppVersionText}"

        Width="1360"
        Height="820"

        MinWidth="1100"
        MinHeight="700"

        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}"

        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <!-- ========================================================= -->
    <!-- CUSTOM WINDOW CHROME                                      -->
    <!-- ========================================================= -->

    <shell:WindowChrome.WindowChrome>

        <shell:WindowChrome
            CaptionHeight="0"
            ResizeBorderThickness="6"
            GlassFrameThickness="0"
            CornerRadius="18"
            UseAeroCaptionButtons="False"/>

    </shell:WindowChrome.WindowChrome>


    <Grid Background="{DynamicResource AppBackgroundBrush}">


        <!-- ========================================================= -->
        <!-- BACKGROUND                                                 -->
        <!-- ========================================================= -->

        <Image x:Name="BackgroundImage"
               Stretch="UniformToFill"
               Panel.ZIndex="0"
               Grid.RowSpan="2"
               Grid.ColumnSpan="2"
               Visibility="Collapsed">

            <Image.Effect>
                <BlurEffect Radius="8"/>
            </Image.Effect>

        </Image>


        <!-- Voile sombre -->

        <Rectangle Fill="#AA000000"
                   Panel.ZIndex="1"
                   Grid.RowSpan="2"
                   Grid.ColumnSpan="2"
                   Visibility="Collapsed"/>


        <!-- ========================================================= -->
        <!-- INTERFACE                                                  -->
        <!-- ========================================================= -->

        <Grid Panel.ZIndex="2"
              Margin="28,28,28,28"
              Grid.RowSpan="2"
              Grid.ColumnSpan="2"
              Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>




            <!-- ===================================================== -->
            <!-- GAME STATE STATUS                                      -->
            <!-- ===================================================== -->

            <TextBlock x:Name="GameStateStatusText"
                       Text="{Binding GameStateStatusText}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="White"
                       Margin="10,87,0,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Panel.ZIndex="20"/>


            <!-- ===================================================== -->
            <!-- OSU! LIBRARY                                           -->
            <!-- ===================================================== -->

            <Grid HorizontalAlignment="Stretch"
                   VerticalAlignment="Top"
                   Panel.ZIndex="20">

                <StackPanel x:Name="AnalyzerLibraryPanel"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="10,115,0,0">

                <TextBlock Text="OSU! LIBRARY"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#88FFFFFF"/>

                <TextBlock Text="Songs folder:"
                           FontSize="11"
                           Foreground="#88FFFFFF"
                           Margin="0,4,0,0"/>

                <TextBlock x:Name="SongsFolderText"
                           Text="Not set"
                           FontSize="11"
                           Foreground="White"
                           MaxWidth="260"
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel Orientation="Horizontal"
                            Margin="0,6,0,0">

                    <Button Content="Change Folder"
                            x:Name="ChangeSongsFolderButton"
                            Click="ChangeSongsFolder_Click"
                            Padding="10,4"/>

                    <Button Content="Scan Library"
                            x:Name="ScanLibraryButton"
                            Click="ScanLibrary_Click"
                            Padding="10,4"
                            Margin="6,0,0,0"/>

                </StackPanel>

                <Border x:Name="LibraryScanProgressPanel"
                        Visibility="Collapsed"
                        Margin="0,8,0,0"
                        Padding="8"
                        MaxWidth="300"
                        Background="#1EFFFFFF"
                        BorderBrush="#44FFFFFF"
                        BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel>
                        <TextBlock x:Name="LibraryScanStatusText"
                                   Text="Scanning library..."
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                        <ProgressBar x:Name="LibraryScanProgressBar"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="6"
                                     Margin="0,6,0,0"/>
                        <TextBlock x:Name="LibraryScanProgressText"
                                   Text="Processed 0 / 0"
                                   FontSize="10"
                                   Foreground="#CCFFFFFF"
                                   Margin="0,5,0,0"/>
                        <TextBlock x:Name="LibraryScanPercentText"
                                   Text="0.0%"
                                   FontSize="10"
                                   Foreground="#CCFFFFFF"/>
                        <TextBlock x:Name="LibraryScanAnalyzedText"
                                   Text="Analyzed: 0"
                                   FontSize="10"
                                   Foreground="#CCFFFFFF"/>
                        <TextBlock x:Name="LibraryScanUpToDateText"
                                   Text="Up to date: 0"
                                   FontSize="10"
                                   Foreground="#CCFFFFFF"/>
                        <TextBlock x:Name="LibraryScanUnsupportedText"
                                   Text="Unsupported: 0"
                                   FontSize="10"
                                   Foreground="#CCFFFFFF"/>
                        <TextBlock x:Name="LibraryScanFailedText"
                                   Text="Failed: 0"
                                   FontSize="10"
                                   Foreground="#CCFFFFFF"/>
                        <TextBlock x:Name="LibraryScanCurrentFileText"
                                   Text="Current file: —"
                                   FontSize="10"
                                   Foreground="#99FFFFFF"
                                   Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="CancelLibraryScanButton"
                                Content="Cancel Scan"
                                Click="CancelLibraryScan_Click"
                                Padding="8,3"
                                Margin="0,7,0,0"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                </StackPanel>

                <!-- ===================================================== -->
                <!-- TOP DASHBOARD                                          -->
                <!-- ===================================================== -->

                <ScrollViewer x:Name="MlLabWorkspacePanel"
                              Visibility="Collapsed"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Top"
                              Width="880"
                              Height="850"
                              Margin="0,40,0,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                <!-- ===================================================== -->
                <!-- ML DATASET                                             -->
                <!-- ===================================================== -->

                <Border Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,6,0"
                        Padding="10"
                        Background="#16000000"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="ML DATASET"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#88FFFFFF"/>

                        <TextBlock x:Name="DatasetSampleCountText"
                                   Text="Samples: 0"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Margin="0,5,0,0"/>
                        <TextBlock x:Name="DatasetValidatedCountText"
                                   Text="Validated: 0"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#CCFFFFFF"/>
                        <TextBlock x:Name="DatasetUnlabeledCountText"
                                   Text="Unlabeled: 0"
                                   FontSize="10"
                                   Foreground="#CCFFFFFF"/>

                        <Button x:Name="BuildDatasetButton"
                                Content="Build Dataset"
                                Click="BuildDataset_Click"
                                Height="27"
                                Padding="10,4"
                                Margin="0,7,0,0"
                                HorizontalAlignment="Stretch"/>

                        <Border x:Name="DatasetBuildProgressPanel"
                                Visibility="Collapsed"
                                Margin="0,8,0,0"
                                Padding="8"
                                Background="#1EFFFFFF"
                                BorderBrush="#44FFFFFF"
                                BorderThickness="1"
                                CornerRadius="4">
                            <StackPanel>
                                <TextBlock x:Name="DatasetBuildStatusText"
                                           Text="Building ML dataset..."
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="White"/>
                                <ProgressBar x:Name="DatasetBuildProgressBar"
                                             Minimum="0"
                                             Maximum="100"
                                             Height="6"
                                             Margin="0,6,0,0"/>
                                <TextBlock x:Name="DatasetBuildProgressText"
                                           Text="0 / 0"
                                           FontSize="10"
                                           Foreground="#CCFFFFFF"
                                           Margin="0,5,0,0"/>
                                <TextBlock x:Name="DatasetBuildPercentText"
                                           Text="0.0%"
                                           FontSize="10"
                                           Foreground="#CCFFFFFF"/>
                                <TextBlock x:Name="DatasetBuildCapturedText"
                                           Text="Captured: 0"
                                           FontSize="10"
                                           Foreground="#CCFFFFFF"/>
                                <TextBlock x:Name="DatasetBuildUpToDateText"
                                           Text="Up to date: 0"
                                           FontSize="10"
                                           Foreground="#CCFFFFFF"/>
                                <TextBlock x:Name="DatasetBuildUnsupportedText"
                                           Text="Unsupported: 0"
                                           FontSize="10"
                                           Foreground="#CCFFFFFF"/>
                                <TextBlock x:Name="DatasetBuildFailedText"
                                           Text="Failed: 0"
                                           FontSize="10"
                                           Foreground="#CCFFFFFF"/>
                                <TextBlock x:Name="DatasetBuildCurrentFileText"
                                           Text="Current: —"
                                           FontSize="10"
                                           Foreground="#99FFFFFF"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button x:Name="CancelDatasetBuildButton"
                                        Content="Cancel Dataset Build"
                                        Click="CancelDatasetBuild_Click"
                                        Height="27"
                                        Padding="8,3"
                                        Margin="0,7,0,0"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BackfillBeatmapIdsButton"
                                Content="Backfill Beatmap IDs"
                                Click="BackfillBeatmapIds_Click"
                                Height="27"
                                Padding="10,4"
                                Margin="0,7,0,0"
                                HorizontalAlignment="Stretch"/>

                        <Border x:Name="BeatmapIdBackfillPanel"
                                Visibility="Collapsed"
                                Margin="0,8,0,0"
                                Padding="8"
                                Background="#1EFFFFFF"
                                BorderBrush="#44FFFFFF"
                                BorderThickness="1"
                                CornerRadius="4">
                            <StackPanel>
                                <TextBlock x:Name="BeatmapIdBackfillStatusText"
                                           Text="Backfilling Beatmap IDs..."
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="White"/>
                                <ProgressBar x:Name="BeatmapIdBackfillProgressBar"
                                             Minimum="0"
                                             Maximum="100"
                                             Height="6"
                                             Margin="0,6,0,0"/>
                                <TextBlock x:Name="BeatmapIdBackfillUpdatedText"
                                           Text="Updated: 0"
                                           FontSize="10"
                                           Foreground="#CCFFFFFF"
                                           Margin="0,5,0,0"/>
                                <TextBlock x:Name="BeatmapIdBackfillAlreadyPopulatedText"
                                           Text="Already populated: 0"
                                           FontSize="10"
                                           Foreground="#CCFFFFFF"/>
                                <TextBlock x:Name="BeatmapIdBackfillMissingInvalidText"
                                           Text="Missing/invalid: 0"
                                           FontSize="10"
                                           Foreground="#CCFFFFFF"/>
                                <TextBlock x:Name="BeatmapIdBackfillFailedText"
                                           Text="Failed: 0"
                                           FontSize="10"
                                           Foreground="#CCFFFFFF"/>
                                <TextBlock x:Name="BeatmapIdBackfillCurrentFileText"
                                           Text="Current: —"
                                           FontSize="10"
                                           Foreground="#99FFFFFF"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button x:Name="CancelBeatmapIdBackfillButton"
                                        Content="Cancel Backfill"
                                        Click="CancelBeatmapIdBackfill_Click"
                                        Height="27"
                                        Padding="8,3"
                                        Margin="0,7,0,0"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===================================================== -->
                <!-- FAST LABELING                                         -->
                <!-- ===================================================== -->

                <Border Grid.Row="0"
                        Grid.Column="1"
                        Margin="3,0"
                        Padding="10"
                        Background="#16000000"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="FAST LABELING"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#88FFFFFF"/>
                        <TextBlock x:Name="FastLabelingProgressText"
                                   Text="Progress: 0 / 0"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Margin="0,7,0,0"/>
                        <TextBlock x:Name="FastLabelingRemainingText"
                                   Text="Remaining: 0"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#CCFFFFFF"/>
                        <TextBlock x:Name="FastLabelingModeText"
                                   Text="Mode: Off"
                                   FontSize="10"
                                   Foreground="#99FFFFFF"
                                   Margin="0,3,0,0"/>
                        <Button x:Name="PreviousUnlabeledButton"
                                Content="Previous Unlabeled"
                                Click="PreviousUnlabeled_Click"
                                Height="27"
                                Padding="7,3"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"/>
                        <Button x:Name="NextUnlabeledButton"
                                Content="Next Unlabeled"
                                Click="NextUnlabeled_Click"
                                Height="27"
                                Padding="7,3"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Stretch"/>
                        <Button x:Name="NextTechCandidateButton"
                                Content="Next Tech Candidate"
                                Click="NextTechCandidate_Click"
                                Height="27"
                                Padding="7,3"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Stretch"/>
                        <Button x:Name="ExitFastLabelingButton"
                                Content="Exit Fast Labeling"
                                Click="ExitFastLabeling_Click"
                                IsEnabled="False"
                                Height="27"
                                Padding="7,3"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <!-- ===================================================== -->
                <!-- CALIBRATION                                          -->
                <!-- ===================================================== -->

                <Border Grid.Row="0"
                        Grid.Column="2"
                        Margin="6,0,0,0"
                        Padding="10"
                        Background="#16000000"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="CALIBRATION"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#88FFFFFF"/>
                        <TextBlock x:Name="CalibrationFoundText"
                                   Text="Found: 0 / 0"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Margin="0,7,0,0"/>
                        <TextBlock x:Name="CalibrationValidatedText"
                                   Text="Validated: 0"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#CCFFFFFF"/>
                        <TextBlock x:Name="CalibrationRemainingText"
                                   Text="Remaining: 0"
                                   FontSize="10"
                                   Foreground="#99FFFFFF"/>
                        <Button x:Name="PreviousCalibrationButton"
                                Content="Previous Calibration"
                                Click="PreviousCalibration_Click"
                                Height="27"
                                Padding="7,3"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"/>
                        <Button x:Name="NextCalibrationButton"
                                Content="Next Calibration"
                                Click="NextCalibration_Click"
                                Height="27"
                                Padding="7,3"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Stretch"/>
                        <Button x:Name="OpenTechReviewWindowButton"
                                Content="Open Tech Review UI"
                                Click="OpenTechReviewWindow_Click"
                                Height="27"
                                Padding="7,3"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Stretch"/>
                        <TextBlock x:Name="CalibrationHintText"
                                   Text="Pack hint: —"
                                   FontSize="10"
                                   Foreground="#99FFFFFF"
                                   Margin="0,7,0,0"/>
                        <TextBlock Text="Sampling hint only — never a Human Label"
                                   FontSize="9"
                                   FontStyle="Italic"
                                   Foreground="#77FFFFFF"/>
                        <TextBlock x:Name="CalibrationCommunityText"
                                   Text="Community: unavailable"
                                   FontSize="10"
                                   Foreground="#99FFFFFF"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ===================================================== -->
                <!-- BEATINSIGHT IDENTITY                                 -->
                <!-- ===================================================== -->

                <!-- Identity is deliberately absent from the normal ML
                     labeling flow. Human labels remain manual and
                     independent from the analyzer classification. -->
                <Border Grid.Row="1"
                         Grid.ColumnSpan="3"
                         Visibility="Visible"
                         Margin="0,8,0,0"
                        Padding="10,8"
                        Background="#16000000"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="BEATINSIGHT IDENTITY"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#88FFFFFF"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="HumanLabelIdentityPrimaryText"
                                   Grid.Column="1"
                                   Text="Primary: —"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="HumanLabelIdentitySecondaryText"
                                   Grid.Column="2"
                                   Text="Secondary: —"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#CCFFFFFF"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="HumanLabelIdentityConfidenceText"
                                   Grid.Column="3"
                                   Text="Confidence: —"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#CCFFFFFF"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ===================================================== -->
                <!-- HUMAN LABEL                                            -->
                <!-- ===================================================== -->

                <Border Grid.Row="2"
                        Grid.ColumnSpan="3"
                        Margin="0,8,0,0"
                        Padding="10"
                        Background="#16000000"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="HUMAN LABEL"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#88FFFFFF"/>

                        <Border Margin="0,7,0,0"
                                Padding="6"
                                Background="#12000000"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1"
                                CornerRadius="3">
                            <StackPanel>
                                <TextBlock x:Name="HumanLabelSampleStatusText"
                                           Text="Dataset sample: Missing"
                                           FontSize="10"
                                           Foreground="#CCFFFFFF"/>
                                <TextBlock x:Name="HumanLabelCurrentPrimaryText"
                                           Text="Primary: Unlabeled"
                                           FontSize="10"
                                           Foreground="White"
                                           Margin="0,2,0,0"/>
                                <TextBlock x:Name="HumanLabelCurrentSecondaryText"
                                           Text="Secondary: —"
                                           FontSize="10"
                                           Foreground="White"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="HUMAN PRIMARY"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="#88FFFFFF"
                                   Margin="0,7,0,1"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Button x:Name="HumanLabelPrimaryStreamButton"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Tag="Stream"
                                    Content="Stream"
                                    Click="SelectPrimaryHumanLabel_Click"
                                    IsEnabled="False"
                                    Padding="7,3"
                                    Margin="0,0,3,4"/>
                            <Button x:Name="HumanLabelPrimaryJumpButton"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Tag="Jump"
                                    Content="Jump"
                                    Click="SelectPrimaryHumanLabel_Click"
                                    IsEnabled="False"
                                    Padding="7,3"
                                    Margin="3,0,0,4"/>
                            <Button x:Name="HumanLabelPrimaryTechButton"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Tag="Tech"
                                    Content="Tech"
                                    Click="SelectPrimaryHumanLabel_Click"
                                    IsEnabled="False"
                                    Padding="7,3"
                                    Margin="0,0,3,0"/>
                            <Button x:Name="HumanLabelPrimaryClassicMixedButton"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Tag="ClassicMixed"
                                    Content="Classic/Mixed"
                                    Click="SelectPrimaryHumanLabel_Click"
                                    IsEnabled="False"
                                    Padding="7,3"
                                    Margin="3,0,0,0"/>
                        </Grid>

                        <TextBlock Text="HUMAN SECONDARY"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="#88FFFFFF"
                                   Margin="0,7,0,1"/>
                        <Button x:Name="HumanLabelSecondaryNoneButton"
                                Tag=""
                                Content="None"
                                Click="SelectSecondaryHumanLabel_Click"
                                IsEnabled="False"
                                Padding="7,3"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Button x:Name="HumanLabelSecondaryStreamButton"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Tag="Stream"
                                    Content="Stream"
                                    Click="SelectSecondaryHumanLabel_Click"
                                    IsEnabled="False"
                                    Padding="7,3"
                                    Margin="0,0,3,4"/>
                            <Button x:Name="HumanLabelSecondaryJumpButton"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Tag="Jump"
                                    Content="Jump"
                                    Click="SelectSecondaryHumanLabel_Click"
                                    IsEnabled="False"
                                    Padding="7,3"
                                    Margin="3,0,0,4"/>
                            <Button x:Name="HumanLabelSecondaryTechButton"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Tag="Tech"
                                    Content="Tech"
                                    Click="SelectSecondaryHumanLabel_Click"
                                    IsEnabled="False"
                                    Padding="7,3"
                                    Margin="0,0,3,0"/>
                            <Button x:Name="HumanLabelSecondaryClassicMixedButton"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Tag="ClassicMixed"
                                    Content="Classic/Mixed"
                                    Click="SelectSecondaryHumanLabel_Click"
                                    IsEnabled="False"
                                    Padding="7,3"
                                    Margin="3,0,0,0"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,7,0,0">
                            <Button x:Name="ValidateHumanLabelButton"
                                    Content="Validate"
                                    Click="ValidateHumanLabel_Click"
                                    IsEnabled="False"
                                    Padding="9,3"/>
                            <Button x:Name="ClearHumanLabelButton"
                                    Content="Clear Label"
                                    Click="ClearHumanLabel_Click"
                                    IsEnabled="False"
                                    Padding="9,3"
                                    Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===================================================== -->
                <!-- COMMUNITY DISCOVERY                                   -->
                <!-- ===================================================== -->

                <Border Grid.Row="3"
                        Grid.ColumnSpan="3"
                        Margin="0,8,0,0"
                        Padding="10"
                        Background="#16000000"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="COMMUNITY DISCOVERY"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#88FFFFFF"/>
                        <TextBlock Text="Community tags guide candidate selection only. Human labels remain ground truth."
                                   FontSize="10"
                                   FontStyle="Italic"
                                   Foreground="#88FFFFFF"
                                   Margin="0,3,0,0"/>

                        <WrapPanel Margin="0,8,0,0">
                            <TextBlock Text="Target:"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#CCFFFFFF"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,0"/>
                            <Button x:Name="DiscoveryJumpFamilyButton"
                                    Tag="Jump"
                                    Content="Jump"
                                    Click="DiscoveryFamily_Click"
                                    Padding="8,3"
                                    Margin="0,0,3,0"/>
                            <Button x:Name="DiscoveryStreamFamilyButton"
                                    Tag="Stream"
                                    Content="Stream"
                                    Click="DiscoveryFamily_Click"
                                    Padding="8,3"
                                    Margin="0,0,3,0"/>
                            <Button x:Name="DiscoveryTechFamilyButton"
                                    Tag="Tech"
                                    Content="Tech"
                                    Click="DiscoveryFamily_Click"
                                    Padding="8,3"
                                    Margin="0,0,3,0"/>
                            <Button x:Name="DiscoveryReadingFamilyButton"
                                    Tag="Reading"
                                    Content="Reading"
                                    Click="DiscoveryFamily_Click"
                                    Padding="8,3"
                                    Margin="0,0,3,0"/>
                            <Button x:Name="DiscoveryHybridFamilyButton"
                                    Tag="Hybrid"
                                    Content="Hybrid"
                                    Click="DiscoveryFamily_Click"
                                    Padding="8,3"/>

                            <TextBlock Text="Results:"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#CCFFFFFF"
                                       VerticalAlignment="Center"
                                       Margin="14,0,5,0"/>
                            <Button x:Name="Discovery10ResultsButton"
                                    Tag="10"
                                    Content="10"
                                    Click="DiscoveryResultCount_Click"
                                    Padding="8,3"
                                    Margin="0,0,3,0"/>
                            <Button x:Name="Discovery20ResultsButton"
                                    Tag="20"
                                    Content="20"
                                    Click="DiscoveryResultCount_Click"
                                    Padding="8,3"
                                    Margin="0,0,3,0"/>
                            <Button x:Name="Discovery30ResultsButton"
                                    Tag="30"
                                    Content="30"
                                    Click="DiscoveryResultCount_Click"
                                    Padding="8,3"
                                    Margin="0,0,3,0"/>
                            <Button x:Name="Discovery50ResultsButton"
                                    Tag="50"
                                    Content="50"
                                    Click="DiscoveryResultCount_Click"
                                    Padding="8,3"/>
                        </WrapPanel>

                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="74"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="74"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Min ★"
                                       FontSize="10"
                                       Foreground="#CCFFFFFF"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,0"/>
                            <TextBox x:Name="DiscoveryMinStarTextBox"
                                     Grid.Column="1"
                                     Height="25"
                                     Padding="5,2"
                                     ToolTip="Optional minimum star rating"/>
                            <TextBlock Grid.Column="2"
                                       Text="Max ★"
                                       FontSize="10"
                                       Foreground="#CCFFFFFF"
                                       VerticalAlignment="Center"
                                       Margin="12,0,5,0"/>
                            <TextBox x:Name="DiscoveryMaxStarTextBox"
                                     Grid.Column="3"
                                     Height="25"
                                     Padding="5,2"
                                     ToolTip="Optional maximum star rating"/>
                            <Button x:Name="FindDiscoveryCandidatesButton"
                                    Grid.Column="5"
                                    Content="Find Candidates"
                                    Click="FindDiscoveryCandidates_Click"
                                    Height="27"
                                    Padding="10,3"
                                    Margin="12,0,0,0"/>
                            <Button x:Name="CancelDiscoveryButton"
                                    Grid.Column="6"
                                    Content="Cancel"
                                    Click="CancelDiscovery_Click"
                                    IsEnabled="False"
                                    Height="27"
                                    Padding="10,3"
                                    Margin="5,0,0,0"/>
                        </Grid>

                        <TextBlock x:Name="DiscoveryStatusText"
                                   Text="Choose a target and search when ready."
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Margin="0,8,0,0"/>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,2,0,0">
                            <TextBlock x:Name="DiscoverySummaryText"
                                       Text="Owned: 0   In Dataset: 0   Human Validated: 0"
                                       FontSize="10"
                                       Foreground="#CCFFFFFF"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="RefreshDiscoveryLocalStateButton"
                                    Content="Refresh Library State"
                                    Click="RefreshDiscoveryLocalState_Click"
                                    Padding="6,2"
                                    Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="DiscoveryEmptyText"
                                   Text="No candidates found for this filter."
                                   Visibility="Collapsed"
                                   FontSize="10"
                                   Foreground="#CCFFFFFF"
                                   Margin="0,6,0,0"/>

                        <ScrollViewer MaxHeight="340"
                                      Margin="0,7,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="DiscoveryResultsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6"
                                                Padding="8"
                                                Background="#12000000"
                                                BorderBrush="#33FFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0"
                                                           Grid.Column="0"
                                                           Text="{Binding ArtistTitle}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="White"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Row="0"
                                                           Grid.Column="1"
                                                           Text="{Binding StarRating}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#DCEBFF"
                                                           Margin="12,0,0,0"/>

                                                <StackPanel Grid.Row="1"
                                                            Grid.ColumnSpan="2"
                                                            Orientation="Horizontal"
                                                            Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding Difficulty}"
                                                               FontSize="10"
                                                               Foreground="#CCFFFFFF"/>
                                                    <TextBlock Text="   " FontSize="10"/>
                                                    <TextBlock Text="{Binding Mapper}"
                                                               FontSize="10"
                                                               Foreground="#CCFFFFFF"/>
                                                    <TextBlock Text="   " FontSize="10"/>
                                                    <TextBlock Text="{Binding SamplingFamily}"
                                                               FontSize="10"
                                                               Foreground="#A8D8FF"/>
                                                    <TextBlock Text="   " FontSize="10"/>
                                                    <TextBlock Text="{Binding EvidenceScore}"
                                                               FontSize="10"
                                                               Foreground="#A8D8FF"/>
                                                </StackPanel>

                                                <TextBlock Grid.Row="2"
                                                           Grid.ColumnSpan="2"
                                                           Text="{Binding CommunityTags}"
                                                           FontSize="10"
                                                           Foreground="#B9D8C4"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"/>

                                                <Grid Grid.Row="3"
                                                      Grid.ColumnSpan="2"
                                                      Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding AlreadyOwned}"
                                                                   FontSize="10"
                                                                   Foreground="#CCFFFFFF"/>
                                                        <TextBlock Text="{Binding AlreadyInMlDataset}"
                                                                   FontSize="10"
                                                                   Foreground="#CCFFFFFF"/>
                                                        <TextBlock Text="{Binding HumanValidated}"
                                                                   FontSize="10"
                                                                   Foreground="#CCFFFFFF"/>
                                                        <TextBlock FontSize="9"
                                                                   Foreground="#777777"
                                                                   Margin="0,2,0,0">
                                                            <Run Text="Beatmap: "/><Run Text="{Binding BeatmapId}"/>
                                                            <Run Text="   Set: "/><Run Text="{Binding BeatmapSetId}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Tag="{Binding BeatmapId}"
                                                            Content="Open osu! Page"
                                                            Click="OpenDiscoveryCandidate_Click"
                                                            Height="27"
                                                            Padding="8,3"
                                                            VerticalAlignment="Top"
                                                            Margin="8,0,0,0"/>
                                                    <Button Grid.Column="2"
                                                            Tag="{Binding BeatmapId}"
                                                            Content="Load for Review"
                                                            Click="LoadDiscoveryCandidateForReview_Click"
                                                            Visibility="{Binding LoadForReviewButtonVisibility}"
                                                            Height="27"
                                                            Padding="8,3"
                                                            VerticalAlignment="Top"
                                                            Margin="5,0,0,0"/>
                                                    <Button Grid.Column="2"
                                                            Tag="{Binding BeatmapId}"
                                                            Content="Download &amp; Import"
                                                            Click="DownloadAndImportDiscoveryCandidate_Click"
                                                            Visibility="{Binding DownloadButtonVisibility}"
                                                            IsEnabled="{Binding IsDownloadButtonEnabled}"
                                                            Height="27"
                                                            Padding="8,3"
                                                            VerticalAlignment="Top"
                                                            Margin="5,0,0,0"/>
                                                    <Button Grid.Column="3"
                                                            Tag="{Binding BeatmapId}"
                                                            Content="Cancel"
                                                            Click="CancelDiscoveryDownload_Click"
                                                            Visibility="{Binding CancelButtonVisibility}"
                                                            Height="27"
                                                            Padding="8,3"
                                                            VerticalAlignment="Top"
                                                            Margin="5,0,0,0"/>
                                                </Grid>

                                                <TextBlock Grid.Row="4"
                                                           Grid.ColumnSpan="2"
                                                           Text="{Binding DownloadStatusText}"
                                                           FontSize="10"
                                                           FontStyle="Italic"
                                                           Foreground="#E0C97A"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- ===================================================== -->
                <!-- COMMUNITY DATASET GENERATOR                           -->
                <!-- ===================================================== -->

                <Border Grid.Row="4"
                        Grid.ColumnSpan="3"
                        Margin="0,8,0,0"
                        Padding="10"
                        Background="#16000000"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="COMMUNITY DATASET GENERATOR"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#88FFFFFF"/>
                        <TextBlock Text="Accepted community annotations remain distinct from Human Labels."
                                   FontSize="10"
                                   FontStyle="Italic"
                                   Foreground="#88FFFFFF"
                                   Margin="0,3,0,0"/>

                        <WrapPanel Margin="0,8,0,0">
                            <TextBlock Text="Samples / class"
                                       FontSize="10"
                                       Foreground="#CCFFFFFF"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="CommunityGeneratorSamplesPerClassTextBox"
                                     Text="100"
                                     Width="54"
                                     Height="25"
                                     Padding="5,2"
                                     Margin="5,0,12,0"/>
                            <TextBlock Text="Min confidence"
                                       FontSize="10"
                                       Foreground="#CCFFFFFF"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="CommunityGeneratorMinConfidenceTextBox"
                                     Text="0.70"
                                     Width="58"
                                     Height="25"
                                     Padding="5,2"
                                     Margin="5,0,12,0"/>
                            <TextBlock Text="Min ★"
                                       FontSize="10"
                                       Foreground="#CCFFFFFF"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="CommunityGeneratorMinStarTextBox"
                                     Width="54"
                                     Height="25"
                                     Padding="5,2"
                                     Margin="5,0,12,0"
                                     ToolTip="Optional minimum star rating"/>
                            <TextBlock Text="Max ★"
                                       FontSize="10"
                                       Foreground="#CCFFFFFF"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="CommunityGeneratorMaxStarTextBox"
                                     Width="54"
                                     Height="25"
                                     Padding="5,2"
                                     Margin="5,0,12,0"
                                     ToolTip="Optional maximum star rating"/>
                            <TextBlock Text="Max / mapper"
                                       FontSize="10"
                                       Foreground="#CCFFFFFF"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="CommunityGeneratorMaxPerMapperTextBox"
                                     Text="5"
                                     Width="42"
                                     Height="25"
                                     Padding="5,2"
                                     Margin="5,0,0,0"/>
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="GenerateCommunityDatasetButton"
                                    Content="Generate"
                                    Click="GenerateCommunityDataset_Click"
                                    Height="27"
                                    Padding="10,3"/>
                            <Button x:Name="CancelCommunityDatasetGenerationButton"
                                    Content="Cancel"
                                    Click="CancelCommunityDatasetGeneration_Click"
                                    IsEnabled="False"
                                    Height="27"
                                    Padding="10,3"
                                    Margin="5,0,0,0"/>
                            <Button x:Name="ExportCommunityDatasetCsvButton"
                                    Content="Export CSV"
                                    Click="ExportCommunityDatasetCsv_Click"
                                    Height="27"
                                    Padding="10,3"
                                    Margin="5,0,0,0"/>
                        </StackPanel>

                        <TextBlock x:Name="CommunityGeneratorStatusText"
                                   Text="Ready. Community seeds may be selected remotely; local availability is informational."
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#CCFFFFFF"
                                   Margin="0,8,0,0"/>
                        <WrapPanel Margin="0,4,0,0">
                            <TextBlock x:Name="CommunityGeneratorStreamProgressText"
                                       Text="Stream 0/100"
                                       FontSize="10"
                                       Foreground="#CCFFFFFF"
                                       Margin="0,0,14,0"/>
                            <TextBlock x:Name="CommunityGeneratorJumpProgressText"
                                       Text="Jump 0/100"
                                       FontSize="10"
                                       Foreground="#CCFFFFFF"
                                       Margin="0,0,14,0"/>
                            <TextBlock x:Name="CommunityGeneratorTechProgressText"
                                       Text="Tech 0/100"
                                       FontSize="10"
                                       Foreground="#CCFFFFFF"
                                       Margin="0,0,14,0"/>
                            <TextBlock x:Name="CommunityGeneratorClassicMixedProgressText"
                                       Text="Classic/Mixed 0/100"
                                       FontSize="10"
                                       Foreground="#CCFFFFFF"/>
                        </WrapPanel>
                        <TextBlock x:Name="CommunityGeneratorCountersText"
                                   Text="Selected: 0   Already local: 0   Need acquisition: 0   Rejected ambiguous: 0   Low confidence: 0   Duplicate: 0   Diversity cap: 0"
                                   FontSize="10"
                                   Foreground="#99FFFFFF"
                                   Margin="0,3,0,0"/>
                        <TextBlock x:Name="CommunityGeneratorCurrentText"
                                   Text=""
                                   FontSize="10"
                                   FontStyle="Italic"
                                   Foreground="#99FFFFFF"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                </Grid>

                </ScrollViewer>

            </Grid>


            <!-- ===================================================== -->
            <!-- HEADER                                                  -->
            <!-- ===================================================== -->

            <Grid x:Name="AnalyzerHeaderPanel"
      Grid.Row="0"
      Height="86"
      Margin="0,0,0,12">

                <Border Background="#D9101016"
            BorderBrush="#3AFF2E93"
            BorderThickness="1"
            CornerRadius="18"
            Padding="18,10">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- ================================================= -->
                        <!-- LOGO / BRAND                                      -->
                        <!-- ================================================= -->

                        <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                            <Border Width="54"
                        Height="54"
                        CornerRadius="27"
                        BorderBrush="{StaticResource AccentMagentaBrush}"
                        BorderThickness="2"
                        Background="#22101420"
                        Margin="0,0,14,0">

                                <Grid>
                                    <TextBlock Text="BI"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                                </Grid>

                            </Border>

                            <TextBlock FontSize="31"
                           FontWeight="Bold"
                           VerticalAlignment="Center">

                    <Run Text="Beat"
                         Foreground="White"/>

                    <Run Text="Insight"
                         Foreground="{StaticResource AccentMagentaBrush}"/>

                            </TextBlock>

                        </StackPanel>

                        <!-- ================================================= -->
                        <!-- RIGHT SIDE                                        -->
                        <!-- ================================================= -->

                        <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                            <!-- Settings -->
                            <Button Width="42"
                        Height="42"
                        Margin="0,0,14,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Content="⚙"
                        Foreground="White"
                        FontSize="20"
                        Cursor="Hand"/>


                            <!-- Analysis assistant identity -->
                            <Border Width="260"
                        Height="58"
                                Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="8">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Temporary avatar -->
                                    <Border Grid.Column="0"
                                Width="40"
                                Height="40"
                                CornerRadius="20"
                                BorderBrush="{DynamicResource AppBorderAccentBrush}"
                                BorderThickness="2"
                                Background="{DynamicResource AppAccentSoftBrush}">

                                        <TextBlock Text="B"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="17"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                                    </Border>


                                    <StackPanel Grid.Column="1"
                                    Margin="10,0,8,0"
                                    VerticalAlignment="Center">

                                        <TextBlock Text="{Binding Overview.Assistant.Name}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                                        <TextBlock Text="Your Analysis Assistant"
                                       FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                                    </StackPanel>


                                    <Ellipse Grid.Column="2"
                                 Width="8"
                                 Height="8"
                                 Fill="#43E36B"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>

                                </Grid>

                            </Border>

                        </StackPanel>

                    </Grid>

                </Border>

            </Grid>


            <!-- ===================================================== -->
            <!-- CENTRE                                                  -->
            <!-- ===================================================== -->

            <Grid x:Name="AnalyzerWorkspacePanel"
                  Grid.Row="1"
                  Margin="0,8,0,5">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ================================================= -->
                <!-- TAB NAVIGATION                                     -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,10">

                    <RadioButton x:Name="OverviewTabButton"
                                 Content="Overview"
                                 GroupName="AnalyzerTabs"
                                 Style="{StaticResource TabButtonNavStyle}"
                                 IsChecked="{Binding IsOverviewTabActive, Mode=OneWay}"
                                 Checked="AnalyzerTab_Checked"
                                 Tag="Overview"/>

                    <RadioButton x:Name="SkillsTabButton"
                                 Content="Skills"
                                 GroupName="AnalyzerTabs"
                                 Style="{StaticResource TabButtonNavStyle}"
                                 IsChecked="{Binding IsSkillsTabActive, Mode=OneWay}"
                                 Checked="AnalyzerTab_Checked"
                                 Tag="Skills"/>

                    <RadioButton x:Name="SectionsTabButton"
                                 Content="Sections"
                                 GroupName="AnalyzerTabs"
                                 Style="{StaticResource TabButtonNavStyle}"
                                 IsChecked="{Binding IsSectionsTabActive, Mode=OneWay}"
                                 Checked="AnalyzerTab_Checked"
                                 Tag="Sections"/>

                    <RadioButton x:Name="IdentityTabButton"
                                 Content="Identity"
                                 GroupName="AnalyzerTabs"
                                 Style="{StaticResource TabButtonNavStyle}"
                                 IsChecked="{Binding IsIdentityTabActive, Mode=OneWay}"
                                 Checked="AnalyzerTab_Checked"
                                 Tag="Identity"/>

                    <RadioButton x:Name="DifficultyTabButton"
                                 Content="Difficulty"
                                 GroupName="AnalyzerTabs"
                                 Style="{StaticResource TabButtonNavStyle}"
                                 IsChecked="{Binding IsDifficultyTabActive, Mode=OneWay}"
                                 Checked="AnalyzerTab_Checked"
                                 Tag="Difficulty"/>

                </StackPanel>

                <!-- ================================================= -->
                <!-- TAB CONTENT                                        -->
                <!-- ================================================= -->

                <Grid Grid.Row="1">

                    <!-- Empty state -->
                    <TextBlock Text="Select or play a beatmap to see its analysis."
                               FontSize="16"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,60,0,0"
                               Visibility="{Binding Overview.HasBeatmap, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>

                    <!-- ============================================= -->
                    <!-- TAB: OVERVIEW                                  -->
                    <!-- ============================================= -->

                    <ScrollViewer Visibility="{Binding IsOverviewTabActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel HorizontalAlignment="Center"
                                    Visibility="{Binding Overview.HasBeatmap, Converter={StaticResource BooleanToVisibilityConverter}}">

                            <!-- Ratings -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,10">

                                <Border Style="{StaticResource CardBorderStyle}"
                                        Width="220"
                                        Margin="6">
                                    <StackPanel>
                                        <TextBlock Text="BEATINSIGHT RATING"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Overview.BeatInsightRatingDisplay}"
                                                   FontSize="34"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,1,0,0"/>
                                        <TextBlock Text="{Binding Overview.BeatInsightRatingConfidenceDisplay, StringFormat='Confidence: {0}'}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorderStyle}"
                                        Width="220"
                                        Margin="6">
                                    <StackPanel>
                                        <TextBlock Text="osu! STAR RATING"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Overview.OsuStarRatingDisplay}"
                                                   FontSize="34"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>

                            <!-- BPM / Length / Combo -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Style="{StaticResource CardBorderStyle}" Width="150" Margin="6">
                                    <StackPanel>
                                        <TextBlock Text="BPM" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Overview.BpmDisplay}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorderStyle}" Width="150" Margin="6">
                                    <StackPanel>
                                        <TextBlock Text="DURÉE" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Overview.LengthDisplay}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorderStyle}" Width="150" Margin="6">
                                    <StackPanel>
                                        <TextBlock Text="MAX COMBO" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Overview.MaxComboDisplay}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- AR / OD / CS / HP -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <Border Style="{StaticResource CardBorderStyle}" Width="90" Margin="4" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="AR" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Overview.Ar}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorderStyle}" Width="90" Margin="4" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="OD" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Overview.Od}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorderStyle}" Width="90" Margin="4" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="CS" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Overview.Cs}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorderStyle}" Width="90" Margin="4" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="HP" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Overview.Hp}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Identity summary -->
                            <Border Style="{StaticResource CardBorderStyle}"
                                    Margin="6,10,6,0"
                                    HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="PRIMARY:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Overview.Identity.PrimaryStructure}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{Binding Overview.Identity.PrimaryStructure, Converter={StaticResource StructureToBrushConverter}}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="SECONDARY:"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="18,0,6,0"
                                               Visibility="{Binding Overview.Identity.HasSecondary, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding Overview.Identity.SecondaryStructure}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{Binding Overview.Identity.SecondaryStructure, Converter={StaticResource StructureToBrushConverter}}"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding Overview.Identity.HasSecondary, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding Overview.Identity.GlobalConfidenceDisplay, StringFormat='Confidence: {0}'}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="18,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Analysis assistant -->
                            <Border Style="{StaticResource CardBorderStyle}"
                                    Margin="6,10,6,0"
                                    BorderBrush="{DynamicResource AppBorderAccentBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Overview.Assistant.Name}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AppAccentBrush}"/>
                                        <TextBlock Text="{Binding Overview.Assistant.StatusBadge}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Overview.Assistant.Message}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0"
                                               MaxWidth="620"/>
                                </StackPanel>
                            </Border>

                            <!-- Objects -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Border Style="{StaticResource CardBorderStyle}" Margin="4" Padding="10,5">
                                    <TextBlock FontSize="14" Foreground="{StaticResource TextPrimaryBrush}">
                                        <Run Text="○  "/><Run Text="{Binding Overview.CircleCount}" FontWeight="Bold"/><Run Text=" Circles"/>
                                    </TextBlock>
                                </Border>
                                <Border Style="{StaticResource CardBorderStyle}" Margin="4" Padding="10,5">
                                    <TextBlock FontSize="14" Foreground="{StaticResource TextPrimaryBrush}">
                                        <Run Text="▬  "/><Run Text="{Binding Overview.SliderCount}" FontWeight="Bold"/><Run Text=" Sliders"/>
                                    </TextBlock>
                                </Border>
                                <Border Style="{StaticResource CardBorderStyle}" Margin="4" Padding="10,5">
                                    <TextBlock FontSize="14" Foreground="{StaticResource TextPrimaryBrush}">
                                        <Run Text="◉  "/><Run Text="{Binding Overview.SpinnerCount}" FontWeight="Bold"/><Run Text=" Spinners"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============================================= -->
                    <!-- TAB: SKILLS                                    -->
                    <!-- ============================================= -->

                    <ScrollViewer Visibility="{Binding IsSkillsTabActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Border Style="{StaticResource CardBorderStyle}"
                                Width="480"
                                Visibility="{Binding Overview.HasBeatmap, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding Overview.SkillMetrics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:SkillBarControl/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </ScrollViewer>

                    <!-- ============================================= -->
                    <!-- TAB: SECTIONS                                  -->
                    <!-- ============================================= -->

                    <ScrollViewer Visibility="{Binding IsSectionsTabActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Width="620"
                                    Visibility="{Binding Overview.HasBeatmap, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding Overview.SpikesSummaryText}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding Overview.Sections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorderStyle}"
                                                Margin="0,0,0,6"
                                                Padding="10"
                                                ToolTip="{Binding TooltipText}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Width="10"
                                                        Height="10"
                                                        CornerRadius="5"
                                                        Margin="0,0,10,0"
                                                        Background="{Binding Structure, Converter={StaticResource StructureToBrushConverter}}"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding TimeRangeDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}">
                                                        <Run Text="{Binding Structure}"/><Run Text=" · "/><Run Text="{Binding DominantSignal}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding LocalDifficultyDisplay}"
                                                           FontSize="16"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource AccentMagentaBrush}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============================================= -->
                    <!-- TAB: IDENTITY                                  -->
                    <!-- ============================================= -->

                    <ScrollViewer Visibility="{Binding IsIdentityTabActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Width="620"
                                    Visibility="{Binding Overview.HasBeatmap, Converter={StaticResource BooleanToVisibilityConverter}}">

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Overview.Identity.PrimaryStructure}"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{Binding Overview.Identity.PrimaryStructure, Converter={StaticResource StructureToBrushConverter}}"/>
                                    <TextBlock Text="{Binding Overview.Identity.SecondaryStructure}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding Overview.Identity.SecondaryStructure, Converter={StaticResource StructureToBrushConverter}}"
                                               VerticalAlignment="Center"
                                               Margin="12,4,0,0"
                                               Visibility="{Binding Overview.Identity.HasSecondary, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding Overview.Identity.GlobalConfidenceDisplay, StringFormat='({0})'}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="12,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="MAIN SKILLS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="4,0,0,4"
                                       Visibility="{Binding Overview.Identity.MainSkills, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"/>
                            <ItemsControl ItemsSource="{Binding Overview.Identity.MainSkills}"
                                          Visibility="{Binding Overview.Identity.MainSkills, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorderStyle}" Padding="10,6" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding ScoreDisplay}" FontSize="12" Foreground="{StaticResource AccentMagentaBrush}" Margin="6,0,0,0"/>
                                                <TextBlock Text="{Binding Reliability}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="MAIN PATTERNS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="4,10,0,4"
                                       Visibility="{Binding Overview.Identity.MainPatterns, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"/>
                            <ItemsControl ItemsSource="{Binding Overview.Identity.MainPatterns}"
                                          Visibility="{Binding Overview.Identity.MainPatterns, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorderStyle}" Padding="10,6" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding OccurrenceDisplay}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============================================= -->
                    <!-- TAB: DIFFICULTY                                -->
                    <!-- ============================================= -->

                    <ScrollViewer Visibility="{Binding IsDifficultyTabActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Width="640"
                                    Visibility="{Binding Overview.HasBeatmap, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding Overview.SpikesSummaryText}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,10"/>
                            <Border Style="{StaticResource CardBorderStyle}" Height="260">
                                <controls:SpikeGraphControl Points="{Binding Overview.DifficultyPoints}"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                </Grid>

            </Grid>
        </Grid>

        <views:DashboardView x:Name="DashboardViewHost"
                             Panel.ZIndex="999"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"/>

    </Grid>

</Window>
