<Window x:Class="BeatInsight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BeatInsight"
        Height="700"
        Width="1100"
        MinHeight="650"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="Black">

    <Grid>

        <!-- ========================= -->
        <!-- BACKGROUND                 -->
        <!-- ========================= -->

        <Image x:Name="BackgroundImage"
               Stretch="UniformToFill"
               Panel.ZIndex="0">

            <Image.Effect>
                <BlurEffect Radius="8"/>
            </Image.Effect>

        </Image>

        <!-- Voile sombre -->
        <Rectangle Fill="#AA000000"
                   Panel.ZIndex="1"/>


        <!-- ========================= -->
        <!-- INTERFACE                  -->
        <!-- ========================= -->

        <Grid Panel.ZIndex="2"
              Margin="35">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- ========================= -->
            <!-- HEADER                     -->
            <!-- ========================= -->

            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center">

                <TextBlock Text="{Binding Title}"
                           FontSize="38"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>

                <TextBlock Text="{Binding Artist}"
                           FontSize="18"
                           Foreground="#DDFFFFFF"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>

                <TextBlock Text="{Binding Creator}"
                           FontSize="14"
                           Foreground="#AAFFFFFF"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0"/>

            </StackPanel>


            <!-- ========================= -->
            <!-- CENTRE                     -->
            <!-- ========================= -->

            <Grid Grid.Row="1"
                  Margin="0,20,0,15">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- ========================= -->
                <!-- BEATINSIGHT STAR RATING   -->
                <!-- ========================= -->

                <StackPanel Grid.Row="0"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,15">

                    <TextBlock Text="BEATINSIGHT RATING"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#AAFFFFFF"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding StarRating, StringFormat={}{0:F2}★}"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>

                </StackPanel>


                <!-- ========================= -->
                <!-- MAIN STATS                 -->
                <!-- ========================= -->

                <Grid Grid.Row="1"
                      HorizontalAlignment="Center">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>


                    <!-- BPM -->

                    <Border Grid.Column="0"
                            Background="#660D0D18"
                            BorderBrush="#55FFFFFF"
                            BorderThickness="1"
                            CornerRadius="16"
                            Margin="8"
                            Padding="18">

                        <StackPanel>

                            <TextBlock Text="BPM"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#BFFFFFFF"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding BPM}"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       Margin="0,3,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- DURÉE -->

                    <Border Grid.Column="1"
                            Background="#660D0D18"
                            BorderBrush="#55FFFFFF"
                            BorderThickness="1"
                            CornerRadius="16"
                            Margin="8"
                            Padding="18">

                        <StackPanel>

                            <TextBlock Text="DURÉE"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#BFFFFFFF"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding LengthDisplay}"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       Margin="0,3,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- MAX COMBO -->

                    <Border Grid.Column="2"
                            Background="#660D0D18"
                            BorderBrush="#55FFFFFF"
                            BorderThickness="1"
                            CornerRadius="16"
                            Margin="8"
                            Padding="18">

                        <StackPanel>

                            <TextBlock Text="MAX COMBO"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#BFFFFFFF"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding MaxCombo}"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       Margin="0,3,0,0"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ========================= -->
                <!-- DIFFICULTÉ + PROFIL        -->
                <!-- ========================= -->

                <Grid Grid.Row="2"
                      HorizontalAlignment="Center"
                      Margin="0,18,0,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- ========================= -->
                    <!-- AR / OD / CS / HP         -->
                    <!-- ========================= -->

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>


                        <!-- AR -->

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="AR"
                                       Foreground="#AAFFFFFF"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding AR}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"/>

                        </StackPanel>


                        <!-- OD -->

                        <StackPanel Grid.Column="1">

                            <TextBlock Text="OD"
                                       Foreground="#AAFFFFFF"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding OD}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"/>

                        </StackPanel>


                        <!-- CS -->

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="CS"
                                       Foreground="#AAFFFFFF"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding CS}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"/>

                        </StackPanel>


                        <!-- HP -->

                        <StackPanel Grid.Column="3">

                            <TextBlock Text="HP"
                                       Foreground="#AAFFFFFF"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding HP}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"/>

                        </StackPanel>

                    </Grid>


                    <!-- ========================= -->
                    <!-- GAMEPLAY PROFILE           -->
                    <!-- ========================= -->

                    <Grid Grid.Row="1"
                          Margin="0,15,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>


                        <!-- STREAM -->

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="STREAM"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#BFFFFFFF"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding GameplayProfile.StreamRatio, StringFormat={}{0:P0}}"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       Foreground="#C9A0FFFF"
                                       HorizontalAlignment="Center"/>

                        </StackPanel>


                        <!-- JUMP -->

                        <StackPanel Grid.Column="1">

                            <TextBlock Text="JUMP"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#BFFFFFFF"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding GameplayProfile.JumpRatio, StringFormat={}{0:P0}}"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       Foreground="#7EC8FFFF"
                                       HorizontalAlignment="Center"/>

                        </StackPanel>


                        <!-- BURST -->

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="BURST"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#BFFFFFFF"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding GameplayProfile.BurstRatio, StringFormat={}{0:P0}}"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       Foreground="#FFE28AFF"
                                       HorizontalAlignment="Center"/>

                        </StackPanel>


                        <!-- TECH -->

                        <StackPanel Grid.Column="3">

                            <TextBlock Text="TECH"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#BFFFFFFF"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding GameplayProfile.TechScore, StringFormat={}{0:F0}/100}"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       Foreground="#FFB36BFF"
                                       HorizontalAlignment="Center"/>

                        </StackPanel>

                    </Grid>


                    <!-- ========================= -->
                    <!-- GAMEPLAY IDENTITY          -->
                    <!-- ========================= -->

                    <StackPanel Grid.Row="2"
                                HorizontalAlignment="Center"
                                Margin="0,15,0,0"
                                MaxWidth="850">

                        <!-- TITRE -->

                        <TextBlock Text="GAMEPLAY IDENTITY"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#99FFFFFF"
                                   HorizontalAlignment="Center"/>


                        <!-- IDENTITY -->

                        <TextBlock Text="{Binding GameplayProfile.Identity.FullName}"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="800"
                                   Margin="0,2,0,0"/>


                        <!-- CONFIDENCE -->

                        <TextBlock Text="{Binding GameplayProfile.Identity.Confidence,
                                                   StringFormat=Confidence {0:F0}%}"
                                   FontSize="12"
                                   Foreground="#AAFFFFFF"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"/>


                        <!-- TRAITS -->

                        <TextBlock Text="TRAITS"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#88FFFFFF"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,1"/>

                        <TextBlock Text="{Binding GameplayProfile.Identity.TraitsDisplay}"
                                   FontSize="12"
                                   Foreground="#DDFFFFFF"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="800"/>

                    </StackPanel>

                </Grid>

            </Grid>


            <!-- ========================= -->
            <!-- OBJECTS                    -->
            <!-- ========================= -->

            <Grid Grid.Row="2"
                  HorizontalAlignment="Center">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>


                <!-- CIRCLES -->

                <TextBlock Grid.Column="0"
                           FontSize="18"
                           Foreground="White"
                           HorizontalAlignment="Center">

                    <Run Text="○  "/>
                    <Run Text="{Binding CircleCount}"/>
                    <Run Text=" Circles"/>

                </TextBlock>


                <!-- SLIDERS -->

                <TextBlock Grid.Column="1"
                           FontSize="18"
                           Foreground="White"
                           HorizontalAlignment="Center">

                    <Run Text="▬  "/>
                    <Run Text="{Binding SliderCount}"/>
                    <Run Text=" Sliders"/>

                </TextBlock>


                <!-- SPINNERS -->

                <TextBlock Grid.Column="2"
                           FontSize="18"
                           Foreground="White"
                           HorizontalAlignment="Center">

                    <Run Text="◉  "/>
                    <Run Text="{Binding SpinnerCount}"/>
                    <Run Text=" Spinners"/>

                </TextBlock>

            </Grid>

        </Grid>

    </Grid>

</Window>