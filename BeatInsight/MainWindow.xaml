<Window x:Class="BeatInsight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BeatInsight"
         Width="1200"
         Height="980"
         MinWidth="1000"
         MinHeight="950"
    WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="Black"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="162*"/>
            <ColumnDefinition Width="113*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="577*"/>
            <RowDefinition Height="107*"/>
        </Grid.RowDefinitions>


        <!-- ========================================================= -->
        <!-- BACKGROUND                                                 -->
        <!-- ========================================================= -->

        <Image x:Name="BackgroundImage"
               Stretch="UniformToFill"
               Panel.ZIndex="0"
               Grid.RowSpan="2"
               Grid.ColumnSpan="2">

            <Image.Effect>
                <BlurEffect Radius="8"/>
            </Image.Effect>

        </Image>


        <!-- Voile sombre -->

        <Rectangle Fill="#AA000000"
                   Panel.ZIndex="1"
                   Grid.RowSpan="2"
                   Grid.ColumnSpan="2"/>


        <!-- ========================================================= -->
        <!-- INTERFACE                                                  -->
        <!-- ========================================================= -->

        <Grid Panel.ZIndex="2"
              Margin="28,28,28,28"
              Grid.RowSpan="2"
              Grid.ColumnSpan="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===================================================== -->
            <!-- WORKSPACE SELECTOR                                      -->
            <!-- ===================================================== -->

            <Border Grid.Row="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Panel.ZIndex="30"
                    Background="#22090B12"
                    BorderBrush="#4462D9FF"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="3"
                    Margin="0,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AnalyzerWorkspaceButton"
                            Content="Analyzer"
                            Click="AnalyzerWorkspace_Click"
                            Padding="10,4"
                            MinWidth="82"/>
                    <Button x:Name="MlLabWorkspaceButton"
                            Content="ML Lab"
                            Click="MlLabWorkspace_Click"
                            Padding="10,4"
                            MinWidth="72"
                            Margin="4,0,0,0"/>
                </StackPanel>
            </Border>


            <!-- ===================================================== -->
            <!-- TOSU STATUS                                            -->
            <!-- ===================================================== -->

            <TextBlock x:Name="TosuStatusText"
                       Text="● En attente de Tosu..."
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="White"
                       Margin="10,87,0,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Panel.ZIndex="20"/>


            <!-- ===================================================== -->
            <!-- OSU! LIBRARY                                           -->
            <!-- ===================================================== -->

            <Grid HorizontalAlignment="Stretch"
                   VerticalAlignment="Top"
                   Panel.ZIndex="20">

                <StackPanel x:Name="AnalyzerLibraryPanel"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="10,115,0,0">

                <TextBlock Text="OSU! LIBRARY"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#88FFFFFF"/>

                <TextBlock Text="Songs folder:"
                           FontSize="11"
                           Foreground="#88FFFFFF"
                           Margin="0,4,0,0"/>

                <TextBlock x:Name="SongsFolderText"
                           Text="Not set"
                           FontSize="11"
                           Foreground="White"
                           MaxWidth="260"
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel Orientation="Horizontal"
                            Margin="0,6,0,0">

                    <Button Content="Change Folder"
                            x:Name="ChangeSongsFolderButton"
                            Click="ChangeSongsFolder_Click"
                            Padding="10,4"/>

                    <Button Content="Scan Library"
                            x:Name="ScanLibraryButton"
                            Click="ScanLibrary_Click"
                            Padding="10,4"
                            Margin="6,0,0,0"/>

                </StackPanel>

                <Border x:Name="LibraryScanProgressPanel"
                        Visibility="Collapsed"
                        Margin="0,8,0,0"
                        Padding="8"
                        MaxWidth="300"
                        Background="#1EFFFFFF"
                        BorderBrush="#44FFFFFF"
                        BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel>
                        <TextBlock x:Name="LibraryScanStatusText"
                                   Text="Scanning library..."
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                        <ProgressBar x:Name="LibraryScanProgressBar"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="6"
                                     Margin="0,6,0,0"/>
                        <TextBlock x:Name="LibraryScanProgressText"
                                   Text="Processed 0 / 0"
                                   FontSize="10"
                                   Foreground="#CCFFFFFF"
                                   Margin="0,5,0,0"/>
                        <TextBlock x:Name="LibraryScanPercentText"
                                   Text="0.0%"
                                   FontSize="10"
                                   Foreground="#CCFFFFFF"/>
                        <TextBlock x:Name="LibraryScanAnalyzedText"
                                   Text="Analyzed: 0"
                                   FontSize="10"
                                   Foreground="#CCFFFFFF"/>
                        <TextBlock x:Name="LibraryScanUpToDateText"
                                   Text="Up to date: 0"
                                   FontSize="10"
                                   Foreground="#CCFFFFFF"/>
                        <TextBlock x:Name="LibraryScanUnsupportedText"
                                   Text="Unsupported: 0"
                                   FontSize="10"
                                   Foreground="#CCFFFFFF"/>
                        <TextBlock x:Name="LibraryScanFailedText"
                                   Text="Failed: 0"
                                   FontSize="10"
                                   Foreground="#CCFFFFFF"/>
                        <TextBlock x:Name="LibraryScanCurrentFileText"
                                   Text="Current file: —"
                                   FontSize="10"
                                   Foreground="#99FFFFFF"
                                   Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="CancelLibraryScanButton"
                                Content="Cancel Scan"
                                Click="CancelLibraryScan_Click"
                                Padding="8,3"
                                Margin="0,7,0,0"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                </StackPanel>

                <!-- ===================================================== -->
                <!-- TOP DASHBOARD                                          -->
                <!-- ===================================================== -->

                <ScrollViewer x:Name="MlLabWorkspacePanel"
                              Visibility="Collapsed"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Top"
                              Width="880"
                              Height="850"
                              Margin="0,40,0,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                <!-- ===================================================== -->
                <!-- ML DATASET                                             -->
                <!-- ===================================================== -->

                <Border Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,6,0"
                        Padding="10"
                        Background="#16000000"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="ML DATASET"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#88FFFFFF"/>

                        <TextBlock x:Name="DatasetSampleCountText"
                                   Text="Samples: 0"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Margin="0,5,0,0"/>
                        <TextBlock x:Name="DatasetValidatedCountText"
                                   Text="Validated: 0"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#CCFFFFFF"/>
                        <TextBlock x:Name="DatasetUnlabeledCountText"
                                   Text="Unlabeled: 0"
                                   FontSize="10"
                                   Foreground="#CCFFFFFF"/>

                        <Button x:Name="BuildDatasetButton"
                                Content="Build Dataset"
                                Click="BuildDataset_Click"
                                Height="27"
                                Padding="10,4"
                                Margin="0,7,0,0"
                                HorizontalAlignment="Stretch"/>

                        <Border x:Name="DatasetBuildProgressPanel"
                                Visibility="Collapsed"
                                Margin="0,8,0,0"
                                Padding="8"
                                Background="#1EFFFFFF"
                                BorderBrush="#44FFFFFF"
                                BorderThickness="1"
                                CornerRadius="4">
                            <StackPanel>
                                <TextBlock x:Name="DatasetBuildStatusText"
                                           Text="Building ML dataset..."
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="White"/>
                                <ProgressBar x:Name="DatasetBuildProgressBar"
                                             Minimum="0"
                                             Maximum="100"
                                             Height="6"
                                             Margin="0,6,0,0"/>
                                <TextBlock x:Name="DatasetBuildProgressText"
                                           Text="0 / 0"
                                           FontSize="10"
                                           Foreground="#CCFFFFFF"
                                           Margin="0,5,0,0"/>
                                <TextBlock x:Name="DatasetBuildPercentText"
                                           Text="0.0%"
                                           FontSize="10"
                                           Foreground="#CCFFFFFF"/>
                                <TextBlock x:Name="DatasetBuildCapturedText"
                                           Text="Captured: 0"
                                           FontSize="10"
                                           Foreground="#CCFFFFFF"/>
                                <TextBlock x:Name="DatasetBuildUpToDateText"
                                           Text="Up to date: 0"
                                           FontSize="10"
                                           Foreground="#CCFFFFFF"/>
                                <TextBlock x:Name="DatasetBuildUnsupportedText"
                                           Text="Unsupported: 0"
                                           FontSize="10"
                                           Foreground="#CCFFFFFF"/>
                                <TextBlock x:Name="DatasetBuildFailedText"
                                           Text="Failed: 0"
                                           FontSize="10"
                                           Foreground="#CCFFFFFF"/>
                                <TextBlock x:Name="DatasetBuildCurrentFileText"
                                           Text="Current: —"
                                           FontSize="10"
                                           Foreground="#99FFFFFF"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button x:Name="CancelDatasetBuildButton"
                                        Content="Cancel Dataset Build"
                                        Click="CancelDatasetBuild_Click"
                                        Height="27"
                                        Padding="8,3"
                                        Margin="0,7,0,0"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BackfillBeatmapIdsButton"
                                Content="Backfill Beatmap IDs"
                                Click="BackfillBeatmapIds_Click"
                                Height="27"
                                Padding="10,4"
                                Margin="0,7,0,0"
                                HorizontalAlignment="Stretch"/>

                        <Border x:Name="BeatmapIdBackfillPanel"
                                Visibility="Collapsed"
                                Margin="0,8,0,0"
                                Padding="8"
                                Background="#1EFFFFFF"
                                BorderBrush="#44FFFFFF"
                                BorderThickness="1"
                                CornerRadius="4">
                            <StackPanel>
                                <TextBlock x:Name="BeatmapIdBackfillStatusText"
                                           Text="Backfilling Beatmap IDs..."
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="White"/>
                                <ProgressBar x:Name="BeatmapIdBackfillProgressBar"
                                             Minimum="0"
                                             Maximum="100"
                                             Height="6"
                                             Margin="0,6,0,0"/>
                                <TextBlock x:Name="BeatmapIdBackfillUpdatedText"
                                           Text="Updated: 0"
                                           FontSize="10"
                                           Foreground="#CCFFFFFF"
                                           Margin="0,5,0,0"/>
                                <TextBlock x:Name="BeatmapIdBackfillAlreadyPopulatedText"
                                           Text="Already populated: 0"
                                           FontSize="10"
                                           Foreground="#CCFFFFFF"/>
                                <TextBlock x:Name="BeatmapIdBackfillMissingInvalidText"
                                           Text="Missing/invalid: 0"
                                           FontSize="10"
                                           Foreground="#CCFFFFFF"/>
                                <TextBlock x:Name="BeatmapIdBackfillFailedText"
                                           Text="Failed: 0"
                                           FontSize="10"
                                           Foreground="#CCFFFFFF"/>
                                <TextBlock x:Name="BeatmapIdBackfillCurrentFileText"
                                           Text="Current: —"
                                           FontSize="10"
                                           Foreground="#99FFFFFF"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button x:Name="CancelBeatmapIdBackfillButton"
                                        Content="Cancel Backfill"
                                        Click="CancelBeatmapIdBackfill_Click"
                                        Height="27"
                                        Padding="8,3"
                                        Margin="0,7,0,0"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===================================================== -->
                <!-- FAST LABELING                                         -->
                <!-- ===================================================== -->

                <Border Grid.Row="0"
                        Grid.Column="1"
                        Margin="3,0"
                        Padding="10"
                        Background="#16000000"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="FAST LABELING"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#88FFFFFF"/>
                        <TextBlock x:Name="FastLabelingProgressText"
                                   Text="Progress: 0 / 0"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Margin="0,7,0,0"/>
                        <TextBlock x:Name="FastLabelingRemainingText"
                                   Text="Remaining: 0"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#CCFFFFFF"/>
                        <TextBlock x:Name="FastLabelingModeText"
                                   Text="Mode: Off"
                                   FontSize="10"
                                   Foreground="#99FFFFFF"
                                   Margin="0,3,0,0"/>
                        <Button x:Name="PreviousUnlabeledButton"
                                Content="Previous Unlabeled"
                                Click="PreviousUnlabeled_Click"
                                Height="27"
                                Padding="7,3"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"/>
                        <Button x:Name="NextUnlabeledButton"
                                Content="Next Unlabeled"
                                Click="NextUnlabeled_Click"
                                Height="27"
                                Padding="7,3"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Stretch"/>
                        <Button x:Name="ExitFastLabelingButton"
                                Content="Exit Fast Labeling"
                                Click="ExitFastLabeling_Click"
                                IsEnabled="False"
                                Height="27"
                                Padding="7,3"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <!-- ===================================================== -->
                <!-- CALIBRATION                                          -->
                <!-- ===================================================== -->

                <Border Grid.Row="0"
                        Grid.Column="2"
                        Margin="6,0,0,0"
                        Padding="10"
                        Background="#16000000"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="CALIBRATION"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#88FFFFFF"/>
                        <TextBlock x:Name="CalibrationFoundText"
                                   Text="Found: 0 / 0"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Margin="0,7,0,0"/>
                        <TextBlock x:Name="CalibrationValidatedText"
                                   Text="Validated: 0"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#CCFFFFFF"/>
                        <TextBlock x:Name="CalibrationRemainingText"
                                   Text="Remaining: 0"
                                   FontSize="10"
                                   Foreground="#99FFFFFF"/>
                        <Button x:Name="PreviousCalibrationButton"
                                Content="Previous Calibration"
                                Click="PreviousCalibration_Click"
                                Height="27"
                                Padding="7,3"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"/>
                        <Button x:Name="NextCalibrationButton"
                                Content="Next Calibration"
                                Click="NextCalibration_Click"
                                Height="27"
                                Padding="7,3"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Stretch"/>
                        <TextBlock x:Name="CalibrationHintText"
                                   Text="Pack hint: —"
                                   FontSize="10"
                                   Foreground="#99FFFFFF"
                                   Margin="0,7,0,0"/>
                        <TextBlock Text="Sampling hint only — never a Human Label"
                                   FontSize="9"
                                   FontStyle="Italic"
                                   Foreground="#77FFFFFF"/>
                        <TextBlock x:Name="CalibrationCommunityText"
                                   Text="Community: unavailable"
                                   FontSize="10"
                                   Foreground="#99FFFFFF"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ===================================================== -->
                <!-- BEATINSIGHT IDENTITY                                 -->
                <!-- ===================================================== -->

                <!-- Identity is deliberately absent from the normal ML
                     labeling flow. Human labels remain manual and
                     independent from the analyzer classification. -->
                <Border Grid.Row="1"
                         Grid.ColumnSpan="3"
                         Visibility="Collapsed"
                         Margin="0,8,0,0"
                        Padding="10,8"
                        Background="#16000000"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="BEATINSIGHT IDENTITY"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#88FFFFFF"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="HumanLabelIdentityPrimaryText"
                                   Grid.Column="1"
                                   Text="Primary: —"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="HumanLabelIdentitySecondaryText"
                                   Grid.Column="2"
                                   Text="Secondary: —"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#CCFFFFFF"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="HumanLabelIdentityConfidenceText"
                                   Grid.Column="3"
                                   Text="Confidence: —"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#CCFFFFFF"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ===================================================== -->
                <!-- HUMAN LABEL                                            -->
                <!-- ===================================================== -->

                <Border Grid.Row="2"
                        Grid.ColumnSpan="3"
                        Margin="0,8,0,0"
                        Padding="10"
                        Background="#16000000"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="HUMAN LABEL"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#88FFFFFF"/>

                        <Border Margin="0,7,0,0"
                                Padding="6"
                                Background="#12000000"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1"
                                CornerRadius="3">
                            <StackPanel>
                                <TextBlock x:Name="HumanLabelSampleStatusText"
                                           Text="Dataset sample: Missing"
                                           FontSize="10"
                                           Foreground="#CCFFFFFF"/>
                                <TextBlock x:Name="HumanLabelCurrentPrimaryText"
                                           Text="Primary: Unlabeled"
                                           FontSize="10"
                                           Foreground="White"
                                           Margin="0,2,0,0"/>
                                <TextBlock x:Name="HumanLabelCurrentSecondaryText"
                                           Text="Secondary: —"
                                           FontSize="10"
                                           Foreground="White"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="HUMAN PRIMARY"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="#88FFFFFF"
                                   Margin="0,7,0,1"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Button x:Name="HumanLabelPrimaryStreamButton"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Tag="Stream"
                                    Content="Stream"
                                    Click="SelectPrimaryHumanLabel_Click"
                                    IsEnabled="False"
                                    Padding="7,3"
                                    Margin="0,0,3,4"/>
                            <Button x:Name="HumanLabelPrimaryJumpButton"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Tag="Jump"
                                    Content="Jump"
                                    Click="SelectPrimaryHumanLabel_Click"
                                    IsEnabled="False"
                                    Padding="7,3"
                                    Margin="3,0,0,4"/>
                            <Button x:Name="HumanLabelPrimaryTechButton"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Tag="Tech"
                                    Content="Tech"
                                    Click="SelectPrimaryHumanLabel_Click"
                                    IsEnabled="False"
                                    Padding="7,3"
                                    Margin="0,0,3,0"/>
                            <Button x:Name="HumanLabelPrimaryClassicMixedButton"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Tag="ClassicMixed"
                                    Content="Classic/Mixed"
                                    Click="SelectPrimaryHumanLabel_Click"
                                    IsEnabled="False"
                                    Padding="7,3"
                                    Margin="3,0,0,0"/>
                        </Grid>

                        <TextBlock Text="HUMAN SECONDARY"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="#88FFFFFF"
                                   Margin="0,7,0,1"/>
                        <Button x:Name="HumanLabelSecondaryNoneButton"
                                Tag=""
                                Content="None"
                                Click="SelectSecondaryHumanLabel_Click"
                                IsEnabled="False"
                                Padding="7,3"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Button x:Name="HumanLabelSecondaryStreamButton"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Tag="Stream"
                                    Content="Stream"
                                    Click="SelectSecondaryHumanLabel_Click"
                                    IsEnabled="False"
                                    Padding="7,3"
                                    Margin="0,0,3,4"/>
                            <Button x:Name="HumanLabelSecondaryJumpButton"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Tag="Jump"
                                    Content="Jump"
                                    Click="SelectSecondaryHumanLabel_Click"
                                    IsEnabled="False"
                                    Padding="7,3"
                                    Margin="3,0,0,4"/>
                            <Button x:Name="HumanLabelSecondaryTechButton"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Tag="Tech"
                                    Content="Tech"
                                    Click="SelectSecondaryHumanLabel_Click"
                                    IsEnabled="False"
                                    Padding="7,3"
                                    Margin="0,0,3,0"/>
                            <Button x:Name="HumanLabelSecondaryClassicMixedButton"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Tag="ClassicMixed"
                                    Content="Classic/Mixed"
                                    Click="SelectSecondaryHumanLabel_Click"
                                    IsEnabled="False"
                                    Padding="7,3"
                                    Margin="3,0,0,0"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,7,0,0">
                            <Button x:Name="ValidateHumanLabelButton"
                                    Content="Validate"
                                    Click="ValidateHumanLabel_Click"
                                    IsEnabled="False"
                                    Padding="9,3"/>
                            <Button x:Name="ClearHumanLabelButton"
                                    Content="Clear Label"
                                    Click="ClearHumanLabel_Click"
                                    IsEnabled="False"
                                    Padding="9,3"
                                    Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===================================================== -->
                <!-- COMMUNITY DISCOVERY                                   -->
                <!-- ===================================================== -->

                <Border Grid.Row="3"
                        Grid.ColumnSpan="3"
                        Margin="0,8,0,0"
                        Padding="10"
                        Background="#16000000"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="COMMUNITY DISCOVERY"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#88FFFFFF"/>
                        <TextBlock Text="Community tags guide candidate selection only. Human labels remain ground truth."
                                   FontSize="10"
                                   FontStyle="Italic"
                                   Foreground="#88FFFFFF"
                                   Margin="0,3,0,0"/>

                        <WrapPanel Margin="0,8,0,0">
                            <TextBlock Text="Target:"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#CCFFFFFF"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,0"/>
                            <Button x:Name="DiscoveryJumpFamilyButton"
                                    Tag="Jump"
                                    Content="Jump"
                                    Click="DiscoveryFamily_Click"
                                    Padding="8,3"
                                    Margin="0,0,3,0"/>
                            <Button x:Name="DiscoveryStreamFamilyButton"
                                    Tag="Stream"
                                    Content="Stream"
                                    Click="DiscoveryFamily_Click"
                                    Padding="8,3"
                                    Margin="0,0,3,0"/>
                            <Button x:Name="DiscoveryTechFamilyButton"
                                    Tag="Tech"
                                    Content="Tech"
                                    Click="DiscoveryFamily_Click"
                                    Padding="8,3"
                                    Margin="0,0,3,0"/>
                            <Button x:Name="DiscoveryReadingFamilyButton"
                                    Tag="Reading"
                                    Content="Reading"
                                    Click="DiscoveryFamily_Click"
                                    Padding="8,3"
                                    Margin="0,0,3,0"/>
                            <Button x:Name="DiscoveryHybridFamilyButton"
                                    Tag="Hybrid"
                                    Content="Hybrid"
                                    Click="DiscoveryFamily_Click"
                                    Padding="8,3"/>

                            <TextBlock Text="Results:"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#CCFFFFFF"
                                       VerticalAlignment="Center"
                                       Margin="14,0,5,0"/>
                            <Button x:Name="Discovery10ResultsButton"
                                    Tag="10"
                                    Content="10"
                                    Click="DiscoveryResultCount_Click"
                                    Padding="8,3"
                                    Margin="0,0,3,0"/>
                            <Button x:Name="Discovery20ResultsButton"
                                    Tag="20"
                                    Content="20"
                                    Click="DiscoveryResultCount_Click"
                                    Padding="8,3"
                                    Margin="0,0,3,0"/>
                            <Button x:Name="Discovery30ResultsButton"
                                    Tag="30"
                                    Content="30"
                                    Click="DiscoveryResultCount_Click"
                                    Padding="8,3"
                                    Margin="0,0,3,0"/>
                            <Button x:Name="Discovery50ResultsButton"
                                    Tag="50"
                                    Content="50"
                                    Click="DiscoveryResultCount_Click"
                                    Padding="8,3"/>
                        </WrapPanel>

                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="74"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="74"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Min ★"
                                       FontSize="10"
                                       Foreground="#CCFFFFFF"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,0"/>
                            <TextBox x:Name="DiscoveryMinStarTextBox"
                                     Grid.Column="1"
                                     Height="25"
                                     Padding="5,2"
                                     ToolTip="Optional minimum star rating"/>
                            <TextBlock Grid.Column="2"
                                       Text="Max ★"
                                       FontSize="10"
                                       Foreground="#CCFFFFFF"
                                       VerticalAlignment="Center"
                                       Margin="12,0,5,0"/>
                            <TextBox x:Name="DiscoveryMaxStarTextBox"
                                     Grid.Column="3"
                                     Height="25"
                                     Padding="5,2"
                                     ToolTip="Optional maximum star rating"/>
                            <Button x:Name="FindDiscoveryCandidatesButton"
                                    Grid.Column="5"
                                    Content="Find Candidates"
                                    Click="FindDiscoveryCandidates_Click"
                                    Height="27"
                                    Padding="10,3"
                                    Margin="12,0,0,0"/>
                            <Button x:Name="CancelDiscoveryButton"
                                    Grid.Column="6"
                                    Content="Cancel"
                                    Click="CancelDiscovery_Click"
                                    IsEnabled="False"
                                    Height="27"
                                    Padding="10,3"
                                    Margin="5,0,0,0"/>
                        </Grid>

                        <TextBlock x:Name="DiscoveryStatusText"
                                   Text="Choose a target and search when ready."
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Margin="0,8,0,0"/>
                        <TextBlock x:Name="DiscoverySummaryText"
                                   Text="Owned: 0   In Dataset: 0   Human Validated: 0"
                                   FontSize="10"
                                   Foreground="#CCFFFFFF"
                                   Margin="0,2,0,0"/>
                        <TextBlock x:Name="DiscoveryEmptyText"
                                   Text="No candidates found for this filter."
                                   Visibility="Collapsed"
                                   FontSize="10"
                                   Foreground="#CCFFFFFF"
                                   Margin="0,6,0,0"/>

                        <ScrollViewer MaxHeight="340"
                                      Margin="0,7,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="DiscoveryResultsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6"
                                                Padding="8"
                                                Background="#12000000"
                                                BorderBrush="#33FFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0"
                                                           Grid.Column="0"
                                                           Text="{Binding ArtistTitle}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="White"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Row="0"
                                                           Grid.Column="1"
                                                           Text="{Binding StarRating}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#DCEBFF"
                                                           Margin="12,0,0,0"/>

                                                <StackPanel Grid.Row="1"
                                                            Grid.ColumnSpan="2"
                                                            Orientation="Horizontal"
                                                            Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding Difficulty}"
                                                               FontSize="10"
                                                               Foreground="#CCFFFFFF"/>
                                                    <TextBlock Text="   " FontSize="10"/>
                                                    <TextBlock Text="{Binding Mapper}"
                                                               FontSize="10"
                                                               Foreground="#CCFFFFFF"/>
                                                    <TextBlock Text="   " FontSize="10"/>
                                                    <TextBlock Text="{Binding SamplingFamily}"
                                                               FontSize="10"
                                                               Foreground="#A8D8FF"/>
                                                    <TextBlock Text="   " FontSize="10"/>
                                                    <TextBlock Text="{Binding EvidenceScore}"
                                                               FontSize="10"
                                                               Foreground="#A8D8FF"/>
                                                </StackPanel>

                                                <TextBlock Grid.Row="2"
                                                           Grid.ColumnSpan="2"
                                                           Text="{Binding CommunityTags}"
                                                           FontSize="10"
                                                           Foreground="#B9D8C4"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"/>

                                                <Grid Grid.Row="3"
                                                      Grid.ColumnSpan="2"
                                                      Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding AlreadyOwned}"
                                                                   FontSize="10"
                                                                   Foreground="#CCFFFFFF"/>
                                                        <TextBlock Text="{Binding AlreadyInMlDataset}"
                                                                   FontSize="10"
                                                                   Foreground="#CCFFFFFF"/>
                                                        <TextBlock Text="{Binding HumanValidated}"
                                                                   FontSize="10"
                                                                   Foreground="#CCFFFFFF"/>
                                                        <TextBlock FontSize="9"
                                                                   Foreground="#777777"
                                                                   Margin="0,2,0,0">
                                                            <Run Text="Beatmap: "/><Run Text="{Binding BeatmapId}"/>
                                                            <Run Text="   Set: "/><Run Text="{Binding BeatmapSetId}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Tag="{Binding BeatmapId}"
                                                            Content="Open osu! Page"
                                                            Click="OpenDiscoveryCandidate_Click"
                                                            Height="27"
                                                            Padding="8,3"
                                                            VerticalAlignment="Top"
                                                            Margin="8,0,0,0"/>
                                                    <Button Grid.Column="2"
                                                            Tag="{Binding BeatmapId}"
                                                            Content="Load for Review"
                                                            Click="LoadDiscoveryCandidateForReview_Click"
                                                            Height="27"
                                                            Padding="8,3"
                                                            VerticalAlignment="Top"
                                                            Margin="5,0,0,0"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                </Grid>

                </ScrollViewer>

            </Grid>


            <!-- ===================================================== -->
            <!-- HEADER                                                  -->
            <!-- ===================================================== -->

            <Grid x:Name="AnalyzerHeaderPanel"
                  Grid.Row="0">


                <!-- ================================================= -->
                <!-- TITRE CENTRAL                                      -->
                <!-- ================================================= -->

                <StackPanel HorizontalAlignment="Center">

                    <TextBlock Text="{Binding Title}"
                               FontSize="38"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>


                    <TextBlock Text="{Binding Artist}"
                               FontSize="18"
                               Foreground="#DDFFFFFF"
                               HorizontalAlignment="Center"
                               Margin="0,3,0,0"/>


                    <TextBlock Text="{Binding Creator}"
                               FontSize="14"
                               Foreground="#AAFFFFFF"
                               HorizontalAlignment="Center"
                               Margin="0,1,0,0"/>


                    <TextBlock Text="{Binding Version}"
                               FontSize="14"
                               Foreground="#AAFFFFFF"
                               HorizontalAlignment="Center"
                               Margin="0,1,0,4"/>


                    <!-- ============================================= -->
                    <!-- OSU! COMMUNITY TAGS                           -->
                    <!-- ============================================= -->

                    <TextBlock Text="COMMUNITY TAGS"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#88FFFFFF"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,1"/>


                    <ItemsControl ItemsSource="{Binding CommunityTags}"
                                  HorizontalAlignment="Center"
                                  Margin="0,2,0,8">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>

                                <WrapPanel HorizontalAlignment="Center"/>

                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>


                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Border Background="#33000000"
                                        BorderBrush="#66FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="9,4"
                                        Margin="3,2">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12"
                                                   Foreground="#EEEEEE"/>

                                        <TextBlock Text=" · "
                                                   FontSize="12"
                                                   Foreground="#777777"/>

                                        <TextBlock Text="{Binding Votes}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFFFF"/>

                                    </StackPanel>

                                </Border>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </StackPanel>


                <!-- ================================================= -->
                <!-- ACTIONS GAUCHE                                     -->
                <!-- ================================================= -->

                <StackPanel HorizontalAlignment="Left"
                            VerticalAlignment="Top">

                    <Button Content="Open Beatmap ↗"
                            Click="OpenBeatmap_Click"
                            Padding="12,6"/>


                    <Button Content="📋 Copy Analysis"
                            Click="CopyAnalysis_Click"
                            Padding="12,6"
                            Margin="0,7,0,0"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- VERSION / REPORT DROITE                           -->
                <!-- ================================================= -->

                <StackPanel HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,42,0,0">

                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=AppVersion}"
                               FontSize="11"
                               Foreground="#88FFFFFF"
                               HorizontalAlignment="Right"
                               Margin="0,4,0,10"/>


                    <Button Content="⚠ Classification incorrecte ?"
                            Click="ReportClassification_Click"
                            Padding="12,6"/>

                </StackPanel>

            </Grid>


            <!-- ===================================================== -->
            <!-- CENTRE                                                  -->
            <!-- ===================================================== -->

            <Grid x:Name="AnalyzerWorkspacePanel"
                  Grid.Row="1"
                  Margin="0,8,0,5">

                <Grid.RowDefinitions>
                    <!-- Ratings -->
                    <RowDefinition Height="Auto"/>

                    <!-- BPM / Durée / Combo -->
                    <RowDefinition Height="Auto"/>

                    <!-- AR / OD / CS / HP -->
                    <RowDefinition Height="Auto"/>

                    <!-- Structure -->
                    <RowDefinition Height="Auto"/>

                    <!-- Skill Pressure -->
                    <RowDefinition Height="Auto"/>

                    <!-- Objects -->
                    <RowDefinition Height="Auto"/>

                    <!-- Identity / Community -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- RATINGS                                             -->
                <!-- ================================================= -->

                <Grid Grid.Row="0"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,8">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>


                    <!-- ============================================= -->
                    <!-- BEATINSIGHT RATING                             -->
                    <!-- ============================================= -->

                    <StackPanel Grid.Column="0"
                                HorizontalAlignment="Center">

                        <TextBlock Text="BEATINSIGHT RATING"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#AAFFFFFF"
                                   HorizontalAlignment="Center"/>


                        <TextBlock Text="{Binding BeatInsightRating, StringFormat={}{0:F2}★}"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,1,0,0"/>

                    </StackPanel>


                    <!-- ============================================= -->
                    <!-- OSU STAR RATING                                -->
                    <!-- ============================================= -->

                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Center">

                        <TextBlock Text="osu! STAR RATING"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#AAFFFFFF"
                                   HorizontalAlignment="Center"/>


                        <TextBlock Text="{Binding OsuStarRating, StringFormat={}{0:F2}★}"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,1,0,0"/>

                    </StackPanel>

                </Grid>


                <!-- ================================================= -->
                <!-- BPM / DURÉE / COMBO                                -->
                <!-- ================================================= -->

                <Grid Grid.Row="1"
      HorizontalAlignment="Center">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>


                    <!-- BPM -->

                    <Border Grid.Column="0"
            Background="#66101018"
            BorderBrush="#70FFFFFF"
            BorderThickness="1"
            CornerRadius="16"
            Margin="6"
            Padding="15">

                        <StackPanel>

                            <TextBlock Text="BPM"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#CCFFFFFF"
                       HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding BPM}"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,3,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- DURÉE -->

                    <Border Grid.Column="1"
            Background="#66101018"
            BorderBrush="#70FFFFFF"
            BorderThickness="1"
            CornerRadius="16"
            Margin="6"
            Padding="15">

                        <StackPanel>

                            <TextBlock Text="DURÉE"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#CCFFFFFF"
                       HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding LengthDisplay}"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,3,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- MAX COMBO -->

                    <Border Grid.Column="2"
            Background="#66101018"
            BorderBrush="#70FFFFFF"
            BorderThickness="1"
            CornerRadius="16"
            Margin="6"
            Padding="15">

                        <StackPanel>

                            <TextBlock Text="MAX COMBO"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#CCFFFFFF"
                       HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding MaxCombo}"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,3,0,0"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ================================================= -->
                <!-- AR / OD / CS / HP                                  -->
                <!-- ================================================= -->

                <Grid Grid.Row="2"
      HorizontalAlignment="Center"
      Margin="0,4,0,2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="85"/>
                        <ColumnDefinition Width="85"/>
                        <ColumnDefinition Width="85"/>
                        <ColumnDefinition Width="85"/>
                    </Grid.ColumnDefinitions>


                    <!-- AR -->

                    <Border Grid.Column="0"
            Background="#55101018"
            BorderBrush="#55FFFFFF"
            BorderThickness="1"
            CornerRadius="10"
            Margin="3"
            Padding="7,5">

                        <StackPanel>

                            <TextBlock Text="AR"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#BFFFFFFF"
                       HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding AR}"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,1,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- OD -->

                    <Border Grid.Column="1"
            Background="#55101018"
            BorderBrush="#55FFFFFF"
            BorderThickness="1"
            CornerRadius="10"
            Margin="3"
            Padding="7,5">

                        <StackPanel>

                            <TextBlock Text="OD"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#BFFFFFFF"
                       HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding OD}"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,1,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- CS -->

                    <Border Grid.Column="2"
            Background="#55101018"
            BorderBrush="#55FFFFFF"
            BorderThickness="1"
            CornerRadius="10"
            Margin="3"
            Padding="7,5">

                        <StackPanel>

                            <TextBlock Text="CS"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#BFFFFFFF"
                       HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding CS}"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,1,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- HP -->

                    <Border Grid.Column="3"
            Background="#55101018"
            BorderBrush="#55FFFFFF"
            BorderThickness="1"
            CornerRadius="10"
            Margin="3"
            Padding="7,5">

                        <StackPanel>

                            <TextBlock Text="HP"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#BFFFFFFF"
                       HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding HP}"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,1,0,0"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ================================================= -->
                <!-- GAMEPLAY PROFILE                                   -->
                <!-- ================================================= -->

                <Grid Grid.Row="3"
      HorizontalAlignment="Center"
      Margin="0,8,0,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
               Grid.ColumnSpan="4"
               Text="STRUCTURE"
               FontSize="10"
               FontWeight="SemiBold"
               Foreground="#BFFFFFFF"
               HorizontalAlignment="Center"
               Margin="0,0,0,4"/>


                    <!-- STREAM -->

                    <StackPanel Grid.Row="1"
                                Grid.Column="0">

                        <TextBlock Text="STREAM"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="#FFFF5C5C"
                   HorizontalAlignment="Center"/>

                        <Canvas Width="96"
                Height="28"
                Margin="0,2"
                HorizontalAlignment="Center"
                IsHitTestVisible="False">
                            <Polyline Points="7,18 20,14 33,10 46,8 59,9 72,13 85,18"
                      Stroke="#99FF5C5C"
                      StrokeThickness="0.8"/>
                            <Ellipse Canvas.Left="4" Canvas.Top="15" Width="6" Height="6" Fill="#CCFF5C5C"/>
                            <Ellipse Canvas.Left="17" Canvas.Top="11" Width="6" Height="6" Fill="#CCFF5C5C"/>
                            <Ellipse Canvas.Left="30" Canvas.Top="7" Width="6" Height="6" Fill="#CCFF5C5C"/>
                            <Ellipse Canvas.Left="43" Canvas.Top="5" Width="6" Height="6" Fill="#CCFF5C5C"/>
                            <Ellipse Canvas.Left="56" Canvas.Top="6" Width="6" Height="6" Fill="#CCFF5C5C"/>
                            <Ellipse Canvas.Left="69" Canvas.Top="10" Width="6" Height="6" Fill="#CCFF5C5C"/>
                            <Ellipse Canvas.Left="82" Canvas.Top="15" Width="6" Height="6" Fill="#CCFF5C5C"/>
                        </Canvas>

                        <TextBlock Text="{Binding GameplayProfile.StreamRatio, StringFormat={}{0:P0}}"
                   FontSize="23"
                   FontWeight="Bold"
                   Foreground="#FFFF5C5C"
                   HorizontalAlignment="Center"/>

                    </StackPanel>


                    <!-- JUMP -->

                    <StackPanel Grid.Row="1"
                                Grid.Column="1">

                        <TextBlock Text="JUMP"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="#FF61E6FF"
                   HorizontalAlignment="Center"/>

                        <Canvas Width="96"
                Height="28"
                Margin="0,2"
                HorizontalAlignment="Center"
                IsHitTestVisible="False">
                            <Polyline Points="8,20 28,6 48,23 69,8 88,21"
                      Stroke="#9961E6FF"
                      StrokeThickness="0.8"/>
                            <Ellipse Canvas.Left="4" Canvas.Top="16" Width="8" Height="8" Fill="#CC61E6FF"/>
                            <Ellipse Canvas.Left="24" Canvas.Top="2" Width="8" Height="8" Fill="#CC61E6FF"/>
                            <Ellipse Canvas.Left="44" Canvas.Top="19" Width="8" Height="8" Fill="#CC61E6FF"/>
                            <Ellipse Canvas.Left="65" Canvas.Top="4" Width="8" Height="8" Fill="#CC61E6FF"/>
                            <Ellipse Canvas.Left="84" Canvas.Top="17" Width="8" Height="8" Fill="#CC61E6FF"/>
                        </Canvas>

                        <TextBlock Text="{Binding GameplayProfile.JumpRatio, StringFormat={}{0:P0}}"
                   FontSize="23"
                   FontWeight="Bold"
                   Foreground="#FF61E6FF"
                   HorizontalAlignment="Center"/>

                    </StackPanel>


                    <!-- BURST -->

                    <StackPanel Grid.Row="1"
                                Grid.Column="2">

                        <TextBlock Text="BURST"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="#FFFF9A4D"
                   HorizontalAlignment="Center"/>

                        <Canvas Width="96"
                Height="28"
                Margin="0,2"
                HorizontalAlignment="Center"
                IsHitTestVisible="False">
                            <Polyline Points="34,18 45,12 56,17 67,11 78,16"
                      Stroke="#99FF9A4D"
                      StrokeThickness="0.8"/>
                            <Ellipse Canvas.Left="30" Canvas.Top="14" Width="8" Height="8" Fill="#CCFF9A4D"/>
                            <Ellipse Canvas.Left="41" Canvas.Top="8" Width="8" Height="8" Fill="#CCFF9A4D"/>
                            <Ellipse Canvas.Left="52" Canvas.Top="13" Width="8" Height="8" Fill="#CCFF9A4D"/>
                            <Ellipse Canvas.Left="63" Canvas.Top="7" Width="8" Height="8" Fill="#CCFF9A4D"/>
                            <Ellipse Canvas.Left="74" Canvas.Top="12" Width="8" Height="8" Fill="#CCFF9A4D"/>
                        </Canvas>

                        <TextBlock Text="{Binding GameplayProfile.BurstRatio, StringFormat={}{0:P0}}"
                   FontSize="23"
                   FontWeight="Bold"
                   Foreground="#FFFF9A4D"
                   HorizontalAlignment="Center"/>

                    </StackPanel>


                    <!-- TECH -->

                    <StackPanel Grid.Row="1"
                                Grid.Column="3">

                        <TextBlock Text="TECH"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="#FFB46CFF"
                   HorizontalAlignment="Center"/>

                        <Canvas Width="96"
                Height="28"
                Margin="0,2"
                HorizontalAlignment="Center"
                IsHitTestVisible="False">
                            <Polyline Points="10,19 27,7 44,22 62,6 75,19 88,10"
                      Stroke="#99B46CFF"
                      StrokeThickness="0.8"/>
                            <Line X1="62" Y1="6" X2="95" Y2="6"
                  Stroke="#66B46CFF"
                  StrokeThickness="0.8"/>
                            <Ellipse Canvas.Left="6" Canvas.Top="15" Width="8" Height="8" Fill="#CCB46CFF"/>
                            <Ellipse Canvas.Left="23" Canvas.Top="3" Width="8" Height="8" Fill="#CCB46CFF"/>
                            <Ellipse Canvas.Left="40" Canvas.Top="18" Width="8" Height="8" Fill="#CCB46CFF"/>
                            <Ellipse Canvas.Left="58" Canvas.Top="2" Width="8" Height="8" Fill="#CCB46CFF"/>
                            <Ellipse Canvas.Left="71" Canvas.Top="15" Width="8" Height="8" Fill="#CCB46CFF"/>
                            <Ellipse Canvas.Left="84" Canvas.Top="6" Width="8" Height="8" Fill="#CCB46CFF"/>
                        </Canvas>

                        <TextBlock Text="{Binding GameplayProfile.TechPresence, StringFormat={}{0:F0}%}"
                   FontSize="23"
                   FontWeight="Bold"
                   Foreground="#FFB46CFF"
                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Grid>


                <!-- ================================================= -->
                <!-- SKILL PRESSURE                                     -->
                <!-- ================================================= -->

                <Grid Grid.Row="4"
                      HorizontalAlignment="Center"
                      Margin="0,10,0,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="145"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.ColumnSpan="3"
                               Text="SKILL PRESSURE"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#BFFFFFFF"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>

                    <!-- AIM -->

                    <StackPanel Grid.Row="1"
                                Grid.Column="0"
                                Width="125">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="AIM"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#FF61E6FF"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding GameplayProfile.AimScore, StringFormat={}{0:F0}%}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#FF61E6FF"/>
                        </Grid>

                        <ProgressBar Value="{Binding GameplayProfile.AimScore}"
                                     Maximum="100"
                                     Height="4"
                                     Margin="0,3,0,0"
                                     Background="#33000000"
                                     Foreground="#FF61E6FF"
                                     BorderThickness="0"/>

                    </StackPanel>


                    <!-- SPEED -->

                    <StackPanel Grid.Row="1"
                                Grid.Column="1"
                                Width="125">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="SPEED"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFF5C5C"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding GameplayProfile.SpeedScore, StringFormat={}{0:F0}%}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#FFFF5C5C"/>
                        </Grid>

                        <ProgressBar Value="{Binding GameplayProfile.SpeedScore}"
                                     Maximum="100"
                                     Height="4"
                                     Margin="0,3,0,0"
                                     Background="#33000000"
                                     Foreground="#FFFF5C5C"
                                     BorderThickness="0"/>

                    </StackPanel>


                    <!-- READING -->

                    <StackPanel Grid.Row="1"
                                Grid.Column="2"
                                Width="125">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="READING"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#FFB46CFF"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding GameplayProfile.ReadScore, StringFormat={}{0:F0}%}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#FFB46CFF"/>
                        </Grid>

                        <ProgressBar Value="{Binding GameplayProfile.ReadScore}"
                                     Maximum="100"
                                     Height="4"
                                     Margin="0,3,0,0"
                                     Background="#33000000"
                                     Foreground="#FFB46CFF"
                                     BorderThickness="0"/>

                    </StackPanel>

                </Grid>


                <!-- ================================================= -->
                <!-- GAMEPLAY IDENTITY + COMMUNITY EVIDENCE            -->
                <!-- ================================================= -->

                <Grid Grid.Row="6"
      Margin="20,12,20,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- ================================================= -->
                    <!-- GAMEPLAY IDENTITY                                -->
                    <!-- ================================================= -->

                    <Border Grid.Column="0"
            Background="#66090B12"
            BorderBrush="#66888888"
            BorderThickness="1"
            CornerRadius="16"
            Padding="20,14">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="Auto"/>
                             </Grid.RowDefinitions>


                                <!-- ACCENT -->

                            <Border Grid.Row="0"
                    Height="3"
                    CornerRadius="2"
                    Background="#FF62D9FF"
                    HorizontalAlignment="Stretch"
                    Margin="30,0,30,12"/>


                            <!-- CONTENT -->

                            <StackPanel Grid.Row="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top">

                                <!-- TITLE -->

                                <TextBlock Text="GAMEPLAY IDENTITY"
               FontSize="12"
               FontWeight="Bold"
               Foreground="#CCFFFFFF"
               HorizontalAlignment="Center"/>


                                <!-- IDENTITY -->

                                <TextBlock Text="{Binding GameplayProfile.Identity.FullName}"
               FontSize="22"
               FontWeight="Bold"
               Foreground="White"
               HorizontalAlignment="Center"
               TextAlignment="Center"
               TextWrapping="Wrap"
               Margin="0,3,0,0"/>


                                <!-- CONFIDENCE -->

                                <TextBlock Text="{Binding GameplayProfile.Identity.Confidence,
                       StringFormat=Confidence {0:F0}%}"
               FontSize="12"
               Foreground="#BFFFFFFF"
               HorizontalAlignment="Center"
               Margin="0,2,0,5"/>


                                <ProgressBar Value="{Binding GameplayProfile.Identity.Confidence}"
                 Maximum="100"
                 Height="4"
                 Width="230"
                 HorizontalAlignment="Center"
                 Background="#33FFFFFF"
                 Foreground="#FF62D9FF"
                 BorderThickness="0"
                 Margin="0,0,0,12"/>


                                <!-- ================================================= -->
                                <!-- PRIMARY / SECONDARY -->
                                <!-- ================================================= -->

                                <Grid HorizontalAlignment="Center"
          Margin="0,0,0,10">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>


                                    <!-- PRIMARY -->

                                    <Border Grid.Column="0"
                Background="#22090B12"
                BorderBrush="#5562D9FF"
                BorderThickness="1"
                CornerRadius="9"
                Padding="10,7"
                Margin="3">

                                        <StackPanel>

                                            <TextBlock Text="PRIMARY"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="#AAFFFFFF"
                           HorizontalAlignment="Center"/>

                                            <TextBlock Text="{Binding GameplayProfile.Identity.Primary}"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="#FF62D9FF"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0"/>

                                        </StackPanel>

                                    </Border>


                                    <!-- SECONDARY -->

                                    <Border Grid.Column="1"
                Background="#22090B12"
                BorderBrush="#55B56CFF"
                BorderThickness="1"
                CornerRadius="9"
                Padding="10,7"
                Margin="3">

                                        <StackPanel>

                                            <TextBlock Text="SECONDARY"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="#AAFFFFFF"
                           HorizontalAlignment="Center"/>

                                            <Grid Margin="0,2,0,0">

                                                <TextBlock Text="{Binding GameplayProfile.Identity.Secondary}"
                                                           FontSize="15"
                                                           FontWeight="Bold"
                                                           Foreground="#FFB56CFF"
                                                           HorizontalAlignment="Center"/>

                                                <TextBlock Text="—"
                                                           FontSize="15"
                                                           FontWeight="Bold"
                                                           Foreground="#99FFFFFF"
                                                           HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding GameplayProfile.Identity.Secondary}"
                                                                             Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                            </Grid>

                                        </StackPanel>

                                    </Border>

                                </Grid>


                                <!-- TRAITS -->

                                <TextBlock Text="TRAITS"
               FontSize="10"
               FontWeight="SemiBold"
               Foreground="#AAFFFFFF"
               HorizontalAlignment="Center"
               Margin="0,0,0,4"/>


                                <Border Background="#22FFFFFF"
            BorderBrush="#22FFFFFF"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10,6"
            HorizontalAlignment="Center"
            MaxWidth="530">

                                    <TextBlock Text="{Binding GameplayProfile.Identity.TraitsDisplay}"
                   FontSize="11"
                   Foreground="#DDFFFFFF"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"/>

                                </Border>


                                <!-- WHY -->

                                <TextBlock Text="WHY THIS CLASSIFICATION?"
               FontSize="10"
               FontWeight="SemiBold"
               Foreground="#AAFFFFFF"
               HorizontalAlignment="Center"
               Margin="0,11,0,4"/>


                                <ItemsControl ItemsSource="{Binding GameplayProfile.ClassificationReasons}"
                  MaxWidth="530"
                  HorizontalAlignment="Center">

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                            <TextBlock Text="{Binding}"
                           FontSize="11"
                           Foreground="#CCFFFFFF"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,1,0,1"/>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </StackPanel>
                        </Grid>

                    </Border>


                    <!-- ================================================= -->
                    <!-- SÉPARATEUR                                       -->
                    <!-- ================================================= -->

                    <Border Grid.Column="1"
            Width="1"
            Margin="11,5,11,5"
            Background="#55FFFFFF"
            VerticalAlignment="Stretch"/>


                    <!-- ================================================= -->
                    <!-- COMMUNITY EVIDENCE                               -->
                    <!-- ================================================= -->

                    <Border Grid.Column="2"
            Background="#66090B12"
            BorderBrush="#66888888"
            BorderThickness="1"
            CornerRadius="16"
            Padding="20,14">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>


                            <!-- ACCENT -->

                            <Border Grid.Row="0"
                    Height="3"
                    CornerRadius="2"
                    Background="#FFB56CFF"
                    HorizontalAlignment="Stretch"
                    Margin="30,0,30,12"/>


                            <!-- CONTENT -->

                            <StackPanel Grid.Row="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top">

                                <!-- ================================================= -->
                                <!-- TITLE -->
                                <!-- ================================================= -->

                                <TextBlock Text="COMMUNITY EVIDENCE"
               FontSize="11"
               FontWeight="SemiBold"
               Foreground="#BFFFFFFF"
               HorizontalAlignment="Center"/>

                                <Grid Margin="8,11,8,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="AGREEMENT"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#AAFFFFFF"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0,0,16,6"/>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="1"
                                               Text="{Binding CommunityIdentityAgreement.Agreement,
                                                      StringFormat={}{0:P0},
                                                      TargetNullValue=—}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#FFB56CFF"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Margin="0,0,0,6"/>

                                    <TextBlock Grid.Row="1"
                                               Text="RELIABILITY"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#AAFFFFFF"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0,0,16,6"/>

                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Text="{Binding CommunityIdentityAgreement.Reliability,
                                                      StringFormat={}{0:P0}}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#DDFFFFFF"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Margin="0,0,0,6"/>

                                    <TextBlock Grid.Row="2"
                                               Text="RELEVANT VOTES"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#AAFFFFFF"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0,0,16,6"/>

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="1"
                                               Text="{Binding CommunityIdentityAgreement.RelevantVotes}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#DDFFFFFF"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Margin="0,0,0,6"/>

                                    <TextBlock Grid.Row="3"
                                               Text="MATCHED"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#AAFFFFFF"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0,0,16,6"/>

                                    <TextBlock Grid.Row="3"
                                               Grid.Column="1"
                                               Text="{Binding CommunityIdentityAgreement.MatchedFamiliesDisplay,
                                                      TargetNullValue=None}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#DDFFFFFF"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               TextAlignment="Left"
                                               Margin="0,0,0,6"/>

                                    <TextBlock Grid.Row="4"
                                               Text="CONFLICTS"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#AAFFFFFF"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0,0,16,0"/>

                                    <TextBlock Grid.Row="4"
                                               Grid.Column="1"
                                               Text="{Binding CommunityIdentityAgreement.ConflictingFamiliesDisplay,
                                                      TargetNullValue=None}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#DDFFFFFF"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               TextAlignment="Left"/>

                                </Grid>

                                <TextBlock Text="No structural community evidence"
                                           FontSize="11"
                                           Foreground="#AA99A9B8"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CommunityIdentityAgreement.HasStructuralEvidence}"
                                                             Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                            </StackPanel>

                        </Grid>

                    </Border>

                </Grid>



                <!-- ===================================================== -->
                <!-- OBJECTS                                                -->
                <!-- ===================================================== -->

                <Grid Grid.Row="5"
      Margin="0,10,0,0"
      HorizontalAlignment="Center"
      VerticalAlignment="Top">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>


                    <!-- CIRCLES -->

                    <Border Grid.Column="0"
            Background="#44101018"
            BorderBrush="#45FFFFFF"
            BorderThickness="1"
            CornerRadius="9"
            Margin="5,0"
            Padding="10,5">

                        <TextBlock FontSize="16"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">

            <Run Text="○  "/>
            <Run Text="{Binding CircleCount}"
                 FontWeight="Bold"/>
            <Run Text=" Circles"/>

                        </TextBlock>

                    </Border>


                    <!-- SLIDERS -->

                    <Border Grid.Column="1"
            Background="#44101018"
            BorderBrush="#45FFFFFF"
            BorderThickness="1"
            CornerRadius="9"
            Margin="5,0"
            Padding="10,5">

                        <TextBlock FontSize="16"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">

            <Run Text="▬  "/>
            <Run Text="{Binding SliderCount}"
                 FontWeight="Bold"/>
            <Run Text=" Sliders"/>

                        </TextBlock>

                    </Border>


                    <!-- SPINNERS -->

                    <Border Grid.Column="2"
            Background="#44101018"
            BorderBrush="#45FFFFFF"
            BorderThickness="1"
            CornerRadius="9"
            Margin="5,0"
            Padding="10,5">

                        <TextBlock FontSize="16"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">

            <Run Text="◉  "/>
            <Run Text="{Binding SpinnerCount}"
                 FontWeight="Bold"/>
            <Run Text=" Spinners"/>

                        </TextBlock>

                    </Border>

                </Grid>

            </Grid>

    </Grid>
   
  </Grid>

</Window>
